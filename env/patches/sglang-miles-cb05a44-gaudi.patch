@@ -0,0 +1,291 @@
+"""Manual unit coverage for the Habana-only decode graph runner."""
+
+import unittest
+from types import SimpleNamespace
+
+import torch
+
+from sglang.srt.layers.attention.hpu_blockwise_backend import HPUBlockwiseAttnBackend
+from sglang.srt.layers.attention.hpu_fused_backend import HPUFusedAttnBackend
+from sglang.srt.layers.attention.hpu_attention_utils import (
+    generate_hpu_batch_buckets,
+    generate_padding_aware_buckets,
+    maximum_bucket_padding,
+    parse_hpu_batch_buckets,
+)
+from sglang.srt.layers.attention.hpu_paged_v2_backend import (
+    HPUPagedV2AttnBackend,
+    HPUPagedV2DecodeMetadata,
+)
+from sglang.srt.model_executor.forward_batch_info import CaptureHiddenMode, ForwardMode
+from sglang.srt.model_executor.runner.hpu_graph_runner import (
+    HPUDecodeGraphRunner,
+    _HPUPagedV2StaticInputs,
+    build_blockwise_warmup_shapes,
+    ensure_safe_hpu_graph_attention_backend,
+    install_hpu_layer_mark_step_hooks,
+)
+
+
+class TestHPUGraphRunnerEligibility(unittest.TestCase):
+    @staticmethod
+    def _batch(*, batch_size=8, lengths=None, mode=ForwardMode.EXTEND):
+        if lengths is None:
+            lengths = [1] * batch_size
+        return SimpleNamespace(
+            forward_mode=mode,
+            extend_seq_lens_cpu=lengths,
+            input_ids=SimpleNamespace(shape=(sum(lengths),)),
+            batch_size=batch_size,
+            encoder_lens=None,
+            replace_embeds=None,
+            capture_hidden_mode=CaptureHiddenMode.NULL,
+        )
+
+    @staticmethod
+    def _runner(max_bs=64):
+        runner = HPUDecodeGraphRunner.__new__(HPUDecodeGraphRunner)
+        runner.max_bs = max_bs
+        return runner
+
+    def test_accepts_uniform_single_token_extend(self):
+        batch = self._batch()
+
+        self.assertTrue(self._runner().can_run_graph(batch))
+
+    def test_rejects_multi_token_extend(self):
+        batch = self._batch(lengths=[1, 1, 2, 1])
+
+        self.assertFalse(self._runner().can_run_graph(batch))
+
+    def test_rejects_mixed_mode(self):
+        batch = self._batch(mode=ForwardMode.MIXED)
+
+        self.assertFalse(self._runner().can_run_graph(batch))
+
+    def test_rejects_batch_above_capture_limit(self):
+        batch = self._batch(batch_size=65)
+
+        self.assertFalse(self._runner().can_run_graph(batch))
+
+
+class TestHPUBlockwiseWarmupShapes(unittest.TestCase):
+    def test_padding_aware_buckets_bound_padding_and_include_limits(self):
+        self.assertEqual(
+            generate_padding_aware_buckets(
+                1,
+                32,
+                256,
+                max_padding=64,
+                max_padding_percent=25,
+            ),
+            (1, 2, 4, 8, 16, 32, 64, 96, 128, 160, 192, 256),
+        )
+        self.assertEqual(
+            generate_hpu_batch_buckets(
+                64,
+                32,
+                strategy="pad",
+                max_padding_percent=25,
+            ),
+            (1, 2, 4, 8, 16, 32, 64),
+        )
+
+    def test_parses_explicit_decode_batch_buckets(self):
+        self.assertEqual(
+            parse_hpu_batch_buckets(
+                "1,2,4,8,12,16,24,32,40,48,56,64",
+                64,
+            ),
+            (1, 2, 4, 8, 12, 16, 24, 32, 40, 48, 56, 64),
+        )
+
+    def test_explicit_decode_batch_buckets_must_cover_graph_range(self):
+        with self.assertRaisesRegex(ValueError, "start at 1 and end"):
+            parse_hpu_batch_buckets("1,2,4,8,16,32", 64)
+
+    def test_reports_largest_padding_gap_in_explicit_bucket_lattice(self):
+        self.assertEqual(maximum_bucket_padding((1, 2, 4, 8, 16, 32, 64)), 31)
+        self.assertEqual(maximum_bucket_padding((1, 4, 8)), 3)
+
+    def test_covers_each_reachable_bucket_once(self):
+        shapes = build_blockwise_warmup_shapes(
+            [1, 4], (1, 2, 4, 8, 16), max_blocks_per_request=4
+        )
+
+        self.assertEqual(shapes, [(1, 1), (1, 2), (1, 3), (4, 4), (4, 5), (4, 9)])
+
+    def test_extends_only_small_batch_tail_warmup_coverage(self):
+        shapes = build_blockwise_warmup_shapes(
+            [1, 4, 8],
+            (1, 2, 4, 8, 16, 32, 64),
+            max_blocks_per_request=2,
+            tail_batch_max=4,
+            tail_max_blocks_per_request=8,
+        )
+
+        self.assertEqual(
+            shapes,
+            [
+                (1, 1),
+                (1, 2),
+                (1, 3),
+                (1, 5),
+                (4, 4),
+                (4, 5),
+                (4, 9),
+                (4, 17),
+                (8, 8),
+                (8, 9),
+            ],
+        )
+
+    def test_warms_every_runtime_batch_bucket(self):
+        runner = HPUDecodeGraphRunner.__new__(HPUDecodeGraphRunner)
+        runner.max_bs = 64
