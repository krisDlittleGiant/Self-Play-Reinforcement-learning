+def test_chunk_cache_frees_one_start_per_exclusive_page():
+    page_size = 4
+    allocator = PagedTokenToKVPoolAllocator(
+        size=24,
+        page_size=page_size,
+        dtype=torch.bfloat16,
+        device="cpu",
+        kvcache=_FakeKVCache(num_slots=28),
+        need_sort=False,
+    )
+    allocated = allocator.alloc(2 * page_size)
+    req_to_token = torch.zeros((1, 8), dtype=torch.int64)
+    req_to_token[0].copy_(allocated)
+    cache = ChunkCache.__new__(ChunkCache)
+    cache.req_to_token_pool = SimpleNamespace(req_to_token=req_to_token)
+    cache.token_to_kv_pool_allocator = allocator
+    cache.page_size = page_size
+    req = SimpleNamespace(req_pool_idx=0, cache_protected_len=0)
+
+    cache.cache_finished_req(req, kv_len_to_handle=6)
+
+    torch.testing.assert_close(allocator.free_pages, torch.arange(1, 7))
