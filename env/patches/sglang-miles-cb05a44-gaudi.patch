+            (batch_size, sequence_length)
+            for sequence_length in sequence_lengths
+            for batch_size in batch_sizes
+            if batch_size == max_batch_size
+            or sequence_length <= small_batch_max_sequence_length
+        ]
+        logger.info("Warming %d lazy HPU decode graph buckets", len(warmup_keys))
+        start = time.perf_counter()
+        with self._compile_only_context():
+            for batch_size, sequence_length in reversed(warmup_keys):
+                output = self.execute(
+                    self._make_dummy_decode_batch(batch_size, sequence_length)
+                )
+                del output
+            self._htorch.core.mark_step()
+        self._htorch.hpu.synchronize()
+        self.warmup_time = time.perf_counter() - start
+        logger.info(
+            "Warmed %d lazy HPU decode graph buckets in %.2f seconds",
+            len(warmup_keys),
+            self.warmup_time,
+        )
+
+    def _warmup_blockwise_from_environment(self) -> None:
+        batch_sizes = _parse_positive_int_list(
+            "SGLANG_HPU_BLOCKWISE_GRAPH_WARMUP_BATCHES"
+        )
+        if not batch_sizes:
+            batch_sizes = _parse_positive_int_list(
+                "SGLANG_HPU_DECODE_GRAPH_WARMUP_BATCHES"
+            )
+        if not batch_sizes:
+            return
+        batch_sizes = self._warmup_batch_sizes(batch_sizes)
+        if max(batch_sizes) > self.max_bs:
+            raise ValueError(
+                "HPU blockwise graph warmup batch exceeds the decode graph maximum"
+            )
+
+        max_sequence_length = int(
+            os.environ.get(
+                "SGLANG_HPU_BLOCKWISE_GRAPH_WARMUP_MAX_SEQUENCE_LENGTH",
+                str(self.attn_backend.max_context_length),
+            )
+        )
+        if not 0 < max_sequence_length <= self.attn_backend.max_context_length:
+            raise ValueError(
+                "HPU blockwise graph warmup context must be positive and cannot "
+                "exceed the model context length"
+            )
+        max_blocks_per_request = (
+            max_sequence_length + self.attn_backend.block_size - 1
+        ) // self.attn_backend.block_size
+        tail_max_sequence_length = int(
+            os.environ.get(
+                "SGLANG_HPU_BLOCKWISE_GRAPH_WARMUP_SMALL_BATCH_MAX_SEQUENCE_LENGTH",
+                os.environ.get(
+                    "SGLANG_HPU_DECODE_GRAPH_WARMUP_SMALL_BATCH_MAX_SEQUENCE_LENGTH",
+                    "0",
+                ),
+            )
+        )
+        tail_batch_max = int(
+            os.environ.get("SGLANG_HPU_BLOCKWISE_GRAPH_WARMUP_TAIL_BATCH_MAX", "8")
+        )
+        if tail_batch_max < 0:
+            raise ValueError(
+                "HPU blockwise warmup tail batch maximum cannot be negative"
+            )
+        if tail_max_sequence_length < 0:
+            raise ValueError(
+                "HPU blockwise small-batch warmup context cannot be negative"
+            )
+        if tail_max_sequence_length > self.attn_backend.max_context_length:
+            raise ValueError(
+                "HPU blockwise small-batch warmup context cannot exceed the model context length"
+            )
+        tail_max_blocks_per_request = (
+            (tail_max_sequence_length + self.attn_backend.block_size - 1)
+            // self.attn_backend.block_size
+            if tail_max_sequence_length > 0
+            else None
+        )
+        warmup_shapes = build_blockwise_warmup_shapes(
+            batch_sizes,
+            self.attn_backend.block_buckets,
+            max_blocks_per_request,
+            tail_batch_max=tail_batch_max,
+            tail_max_blocks_per_request=tail_max_blocks_per_request,
+        )
+
+        logger.info(
+            "Warming %d blockwise HPU decode graph buckets: batches=%s, shapes=%s",
+            len(warmup_shapes),
+            batch_sizes,
+            warmup_shapes,
+        )
+        start = time.perf_counter()
+        with self._compile_only_context():
+            for batch_size, total_blocks in reversed(warmup_shapes):
+                blocks_per_request_limit = (
+                    tail_max_blocks_per_request
+                    if tail_max_blocks_per_request is not None
+                    and tail_batch_max > 0
+                    and batch_size <= tail_batch_max
+                    else max_blocks_per_request
+                )
+                blocks_per_request = [1] * batch_size
+                remaining = total_blocks - batch_size
+                for index in range(batch_size):
+                    added = min(remaining, blocks_per_request_limit - 1)
+                    blocks_per_request[index] += added
+                    remaining -= added
+                if remaining:
+                    raise RuntimeError("could not construct blockwise warmup shape")
+                sequence_lengths = [
+                    blocks * self.attn_backend.block_size
+                    for blocks in blocks_per_request
+                ]
+                output = self.execute(
+                    self._make_dummy_decode_batch(batch_size, sequence_lengths)
+                )
+                del output
+            self._htorch.core.mark_step()
+        self._reset_paged_v2_warmup_state()
+        self._htorch.hpu.synchronize()
+        self.warmup_time = time.perf_counter() - start
+        logger.info(
+            "Warmed %d blockwise HPU decode graph buckets in %.2f seconds",
+            len(warmup_shapes),
+            self.warmup_time,
+        )
+
+    def _reset_paged_v2_warmup_state(self) -> None:
+        if not isinstance(self.attn_backend, HPUPagedV2AttnBackend):
+            return
+
+        # Compile-only warmup records writes without executing them. Do not let
+        # its synthetic request rows or allocator state become dependencies of
+        # the first real request wave.
+        self.attn_backend.req_to_token_pool.req_to_token.zero_()
+        self.attn_backend.token_to_kv_pool_allocator.clear()
+        self._htorch.core.mark_step()
+
+    @staticmethod
+    def _is_single_token_extend(forward_batch: ForwardBatch) -> bool:
+        extend_seq_lens = forward_batch.extend_seq_lens_cpu
+        return bool(
+            forward_batch.forward_mode == ForwardMode.EXTEND
+            and extend_seq_lens is not None
+            and len(extend_seq_lens) == forward_batch.batch_size
+            and all(length == 1 for length in extend_seq_lens)
+            and forward_batch.input_ids is not None
+            and forward_batch.input_ids.shape[0] == forward_batch.batch_size
+            and forward_batch.encoder_lens is None
+        )
+
+    def can_run_graph(self, forward_batch: ForwardBatch) -> bool:
+        return (
+            (
+                forward_batch.forward_mode.is_decode()
+                or self._is_single_token_extend(forward_batch)
+            )
+            and forward_batch.batch_size <= self.max_bs
+            and forward_batch.replace_embeds is None
+            and forward_batch.capture_hidden_mode in (None, CaptureHiddenMode.NULL)
+        )
+
+    def load_batch(
+        self,
+        forward_batch: ForwardBatch,
+        padded_batch_size: int,
+        **kwargs,
+    ) -> ForwardBatch:
+        raw_batch_size = forward_batch.batch_size
+        registry = self.eager_runner._eager_registry
+        registry.fill_from(
+            forward_batch,
+            raw_bs=raw_batch_size,
+            padded_bs=padded_batch_size,
+            raw_num_tokens=raw_batch_size,
+            padded_num_tokens=padded_batch_size,
+            pp_proxy_tensors=kwargs.get("pp_proxy_tensors"),
+        )
+        return registry.extract_buffer(
+            padded_bs=padded_batch_size,
+            padded_num_tokens=padded_batch_size,
+            forward_batch_template=forward_batch,
+        )
+
+    @staticmethod
+    def _clone_output(
+        output: LogitsProcessorOutput, raw_batch_size: int
+    ) -> LogitsProcessorOutput:
+        return dataclasses.replace(
+            output,
+            next_token_logits=(
+                output.next_token_logits.clone()[:raw_batch_size]
+                if output.next_token_logits is not None
+                else None
+            ),
+            hidden_states=(
+                output.hidden_states.clone()[:raw_batch_size]
+                if output.hidden_states is not None
+                else None
+            ),
+        )
+
+    def execute(
+        self,
+        forward_batch: ForwardBatch,
+        pp_proxy_tensors=None,
+    ) -> LogitsProcessorOutput:
+        if pp_proxy_tensors is not None:
+            raise NotImplementedError(
+                "HPU decode graphs do not yet support pipeline parallelism"
+            )
+
+        verify_graph = os.environ.get("SGLANG_VERIFY_HPU_DECODE_GRAPH") == "1"
+        raw_batch_size = forward_batch.batch_size
+        padded_batch_size = select_bucket(
+            raw_batch_size,
+            self.attn_backend.batch_buckets,
+        )
+        static_batch = self.load_batch(forward_batch, padded_batch_size)
+        # A cached-prefix EXTEND with exactly one new token per request has the
+        # same model contract as decode. Converting only the static graph view
+        # preserves the scheduler's live batch while avoiding a new full-model
+        # recipe for every fragmented request count.
+        static_batch.forward_mode = ForwardMode.DECODE
+        # Decode token logprobs are computed by Sampler from these logits after
+        # replay, using the original ForwardBatch's sampling metadata. Keep the
+        # captured model contract static, matching the CUDA decode runner.
+        static_batch.return_logprob = False
+        if isinstance(self.attn_backend, HPUPagedV2AttnBackend):
+            # Eager paged-v2 execution consumes materialized block_mapping and
+            # block_bias. The graph adapter derives both tensors from the raw
+            # graph inputs inside capture/replay, so building them here would do
+            # the same work twice on every decode token. Keep verification on
+            # the eager-compatible path because it invokes the raw model below.
+            self.attn_backend.init_forward_metadata(
+                static_batch,
+                materialize=verify_graph,
+            )
+        else:
+            self.attn_backend.init_forward_metadata(static_batch)
+        # Materialize metadata derived from mutable request/KV tables before it
+        # becomes an HPU graph input. Otherwise replay can retain dependencies
+        # on scheduler state that changes before the lazy graph is flushed.
+        self._htorch.core.mark_step()
+        metadata = self.attn_backend.forward_metadata
+        if metadata is None:
+            raise RuntimeError("HPU decode metadata was not initialized")
+
+        if isinstance(
+            metadata,
+            (HPUBlockwiseDecodeMetadata, HPUPagedV2DecodeMetadata),
+        ):
+            key = (padded_batch_size, metadata.padded_num_blocks)
+        else:
+            key = (padded_batch_size, metadata.token_indices.shape[1])
+        self._adapter.forward_batch = static_batch
+        if key not in self._initialized_keys:
+            self._initialized_keys.add(key)
+            if isinstance(
+                metadata,
+                (HPUBlockwiseDecodeMetadata, HPUPagedV2DecodeMetadata),
+            ):
+                logger.info(
+                    "Initializing lazy HPU decode graph for raw_batch_size=%d, "
+                    "batch_size=%d, raw_attention_blocks=%d, "
+                    "attention_bucket=%d",
+                    raw_batch_size,
+                    padded_batch_size,
+                    metadata.num_blocks,
+                    metadata.padded_num_blocks,
+                )
+            else:
+                logger.info(
+                    "Initializing lazy HPU decode graph for raw_batch_size=%d, "
+                    "batch_size=%d, attention_bucket=%d",
+                    raw_batch_size,
+                    *key,
+                )
+        context = ForwardContext(attn_backend=self.attn_backend)
+        kv_pool = self.attn_backend.token_to_kv_pool
+        if isinstance(metadata, HPUPagedV2DecodeMetadata):
+            static_inputs = self._paged_v2_static_inputs.get(key)
+            if static_inputs is None:
+                static_inputs = _HPUPagedV2StaticInputs.from_metadata(metadata)
+                self._paged_v2_static_inputs[key] = static_inputs
+            else:
+                static_inputs.update(metadata)
+            self._htorch.core.mark_step()
+            graph_inputs = [
+                static_batch.input_ids,
+                static_batch.positions,
+                *static_inputs.graph_inputs(),
+            ]
+        else:
+            graph_inputs = [
+                static_batch.input_ids,
+                static_batch.positions,
+                static_batch.out_cache_loc,
+                metadata.token_indices,
+            ]
+        if isinstance(metadata, HPUBlockwiseDecodeMetadata):
+            graph_inputs.extend(
+                [metadata.block_mapping, metadata.block_groups, metadata.block_bias]
+            )
+        elif isinstance(metadata, HPUFusedDecodeMetadata):
+            graph_inputs.append(metadata.attention_mask)
+
+        eager_logits = None
+        eager_kv = None
+        cache_locations = static_batch.out_cache_loc[:raw_batch_size]
+        if verify_graph:
+            # Build the eager reference before graph replay. Habana's graph
+            # wrapper may release cached model intermediates after replay,
+            # making a subsequent raw-model invocation invalid.
+            with forward_context(context):
+                eager_output = self._adapter.model(
+                    static_batch.input_ids,
+                    static_batch.positions,
+                    static_batch,
+                )
+            self._htorch.core.mark_step()
+            self._htorch.hpu.synchronize()
+            eager_logits = eager_output.next_token_logits[:raw_batch_size].float().cpu()
+            eager_kv = [
+                (
+                    key_cache[cache_locations].clone(),
+                    value_cache[cache_locations].clone(),
+                )
+                for key_cache, value_cache in zip(
+                    kv_pool.k_buffer, kv_pool.v_buffer, strict=True
+                )
+            ]
+            self._htorch.core.mark_step()
+            self._htorch.hpu.synchronize()
+
+        with forward_context(context):
+            output = self._graph_model(
+                *graph_inputs,
+                # KV storage lives outside the model's returned tensors. Tell
+                # the Habana graph wrapper these are persistent in-place
+                # outputs so replay publishes each decode step's cache writes.
+                cache_tensors_list=[*kv_pool.k_buffer, *kv_pool.v_buffer],
+            )
+        self._htorch.core.mark_step()
+        # wrap_in_hpu_graph replays synchronously by default. Retain an opt-in
+        # device-wide barrier for diagnosis without serializing every normal
+        # decode step.
+        if os.environ.get("SGLANG_HPU_DECODE_GRAPH_SYNC") == "1":
+            self._htorch.hpu.synchronize()
+        if not isinstance(output, LogitsProcessorOutput):
+            raise TypeError(f"Unexpected HPU graph output type: {type(output)!r}")
+        output = self._clone_output(output, raw_batch_size)
+        if verify_graph:
+            # Padded rows target distinct slots in reserved KV page 0. Exclude
+            # them because only real request slots participate in correctness.
+            graph_kv = [
+                (
+                    key_cache[cache_locations].clone(),
+                    value_cache[cache_locations].clone(),
+                )
+                for key_cache, value_cache in zip(
+                    kv_pool.k_buffer, kv_pool.v_buffer, strict=True
+                )
+            ]
+            self._htorch.core.mark_step()
+            self._htorch.hpu.synchronize()
+            graph_logits = output.next_token_logits.float().cpu()
+            assert eager_logits is not None and eager_kv is not None
+            graph_finite = bool(torch.isfinite(graph_logits).all())
+            eager_finite = bool(torch.isfinite(eager_logits).all())
+            max_abs_diff = float((graph_logits - eager_logits).abs().max())
+            worst_kv_layer = -1
+            worst_kv_diff = 0.0
+            graph_kv_finite = True
+            eager_kv_finite = True
+            for layer_id, ((graph_k, graph_v), (eager_k, eager_v)) in enumerate(
+                zip(graph_kv, eager_kv, strict=True)
+            ):
+                graph_kv_finite &= bool(torch.isfinite(graph_k).all())
+                graph_kv_finite &= bool(torch.isfinite(graph_v).all())
+                eager_kv_finite &= bool(torch.isfinite(eager_k).all())
+                eager_kv_finite &= bool(torch.isfinite(eager_v).all())
+                layer_diff = float(
+                    torch.maximum(
+                        (graph_k.float() - eager_k.float()).abs().max(),
+                        (graph_v.float() - eager_v.float()).abs().max(),
+                    )
+                )
+                if layer_diff > worst_kv_diff:
+                    worst_kv_layer = layer_id
+                    worst_kv_diff = layer_diff
+            if (
+                not graph_finite
+                or not eager_finite
+                or max_abs_diff != 0.0
+                or not graph_kv_finite
+                or not eager_kv_finite
+                or worst_kv_diff != 0.0
+            ):
+                logger.warning(
+                    "HPU graph verification batch=%d attention_bucket=%d: "
+                    "graph_finite=%s eager_finite=%s max_abs_diff=%s "
+                    "graph_kv_finite=%s eager_kv_finite=%s "
+                    "worst_kv_layer=%d worst_kv_diff=%s",
+                    *key,
+                    graph_finite,
+                    eager_finite,
+                    max_abs_diff,
+                    graph_kv_finite,
+                    eager_kv_finite,
+                    worst_kv_layer,
+                    worst_kv_diff,
+                )
+        return output
