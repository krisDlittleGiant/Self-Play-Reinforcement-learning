+"""Decode-only HPU graph runner for SGLang's native Gaudi backends."""
+
+from __future__ import annotations
+
+import contextlib
+import dataclasses
+import logging
+import os
+import time
+from typing import TYPE_CHECKING
+
+import torch
+
+from sglang.srt.layers.attention.hpu_blockwise_backend import (
+    HPUBlockwiseAttnBackend,
+    HPUBlockwiseDecodeMetadata,
+)
+from sglang.srt.layers.attention.hpu_attention_utils import round_up, select_bucket
+from sglang.srt.layers.attention.hpu_fused_backend import (
+    HPUFusedAttnBackend,
+    HPUFusedDecodeMetadata,
+)
+from sglang.srt.layers.attention.hpu_paged_v2_backend import (
+    HPUPagedV2AttnBackend,
+    HPUPagedV2DecodeMetadata,
+    materialize_paged_v2_metadata,
+)
+from sglang.srt.layers.logits_processor import LogitsProcessorOutput
+from sglang.srt.model_executor.forward_batch_info import (
+    CaptureHiddenMode,
+    ForwardBatch,
+    ForwardMode,
+)
+from sglang.srt.model_executor.forward_context import ForwardContext, forward_context
+
+if TYPE_CHECKING:
+    from sglang.srt.model_executor.model_runner import ModelRunner
+    from sglang.srt.model_executor.runner.eager_runner import EagerRunner
+
+logger = logging.getLogger(__name__)
+
+
+def _parse_positive_int_list(name: str) -> list[int]:
+    text = os.environ.get(name, "").strip()
+    if not text:
+        return []
+    try:
+        values = sorted({int(value.strip()) for value in text.split(",")})
+    except ValueError as exc:
+        raise ValueError(f"{name} must be a comma-separated list of integers") from exc
+    if not values or values[0] <= 0:
+        raise ValueError(f"{name} values must be positive")
+    return values
+
+
+class _HPUFusedDecodeAdapter:
+    def __init__(
+        self,
+        model,
+        attn_backend: HPUFusedAttnBackend,
+    ) -> None:
+        self.model = model
+        self.attn_backend = attn_backend
+        self.forward_batch: ForwardBatch | None = None
+
+    def forward(
+        self,
+        input_ids: torch.Tensor,
+        positions: torch.Tensor,
+        out_cache_loc: torch.Tensor,
+        token_indices: torch.Tensor,
+        attention_mask: torch.Tensor,
+    ):
+        if self.forward_batch is None:
+            raise RuntimeError("HPU decode graph adapter has no forward batch")
+        batch_size = input_ids.shape[0]
+        self.forward_batch.input_ids = input_ids
+        self.forward_batch.positions = positions
+        self.forward_batch.out_cache_loc = out_cache_loc
+        self.attn_backend.forward_metadata = HPUFusedDecodeMetadata(
+            batch_size=batch_size,
+            padded_batch_size=token_indices.shape[0],
+            token_indices=token_indices,
+            attention_mask=attention_mask,
+        )
+        return self.model(input_ids, positions, self.forward_batch)
+
+    def __call__(self, *args, **kwargs):
+        return self.forward(*args, **kwargs)
+
+
+class _HPUBlockwiseDecodeAdapter:
+    def __init__(self, model, attn_backend: HPUBlockwiseAttnBackend) -> None:
+        self.model = model
+        self.attn_backend = attn_backend
+        self.forward_batch: ForwardBatch | None = None
+
+    def forward(
+        self,
+        input_ids: torch.Tensor,
+        positions: torch.Tensor,
+        out_cache_loc: torch.Tensor,
+        token_indices: torch.Tensor,
+        block_mapping: torch.Tensor,
+        block_groups: torch.Tensor,
+        block_bias: torch.Tensor,
+    ):
+        if self.forward_batch is None:
+            raise RuntimeError("HPU decode graph adapter has no forward batch")
+        batch_size = input_ids.shape[0]
+        padded_num_blocks = token_indices.shape[0]
+        self.forward_batch.input_ids = input_ids
+        self.forward_batch.positions = positions
+        self.forward_batch.out_cache_loc = out_cache_loc
+        self.attn_backend.forward_metadata = HPUBlockwiseDecodeMetadata(
+            batch_size=batch_size,
+            padded_batch_size=batch_size,
+            num_blocks=padded_num_blocks,
+            padded_num_blocks=padded_num_blocks,
+            token_indices=token_indices,
+            block_mapping=block_mapping,
+            block_groups=block_groups,
+            block_bias=block_bias,
+        )
+        return self.model(input_ids, positions, self.forward_batch)
+
+    def __call__(self, *args, **kwargs):
+        return self.forward(*args, **kwargs)
+
+
+class _HPUPagedV2DecodeAdapter:
+    def __init__(self, model, attn_backend: HPUPagedV2AttnBackend) -> None:
+        self.model = model
+        self.attn_backend = attn_backend
+        self.forward_batch: ForwardBatch | None = None
+
+    def forward(
+        self,
+        input_ids: torch.Tensor,
+        positions: torch.Tensor,
+        slot_mapping: torch.Tensor,
+        block_list: torch.Tensor,
+        block_usage: torch.Tensor,
+        block_groups: torch.Tensor,
+    ):
+        if self.forward_batch is None:
+            raise RuntimeError("HPU decode graph adapter has no forward batch")
+        batch_size = input_ids.shape[0]
+        padded_num_blocks = block_list.shape[0]
+        self.forward_batch.input_ids = input_ids
+        self.forward_batch.positions = positions
+        self.forward_batch.out_cache_loc = slot_mapping
+        metadata = HPUPagedV2DecodeMetadata(
+            batch_size=batch_size,
+            padded_batch_size=batch_size,
+            num_blocks=padded_num_blocks,
+            padded_num_blocks=padded_num_blocks,
+            block_size=self.attn_backend.block_size,
+            block_list=block_list,
+            block_usage=block_usage,
+            block_groups=block_groups,
+            slot_mapping=slot_mapping,
+        )
+        self.attn_backend.forward_metadata = materialize_paged_v2_metadata(
+            metadata,
+            torch.bfloat16,
+        )
+        return self.model(input_ids, positions, self.forward_batch)
+
+    def __call__(self, *args, **kwargs):
+        return self.forward(*args, **kwargs)
+
+
+@dataclasses.dataclass
+class _HPUPagedV2StaticInputs:
+    slot_mapping: torch.Tensor
+    block_list: torch.Tensor
+    block_usage: torch.Tensor
+    block_groups: torch.Tensor
+
+    @classmethod
+    def from_metadata(
+        cls,
+        metadata: HPUPagedV2DecodeMetadata,
+    ) -> _HPUPagedV2StaticInputs:
+        buffers = cls(
+            slot_mapping=torch.empty_like(metadata.slot_mapping),
+            block_list=torch.empty_like(metadata.block_list),
+            block_usage=torch.empty_like(metadata.block_usage),
+            block_groups=torch.empty_like(metadata.block_groups),
+        )
+        buffers.update(metadata)
+        return buffers
+
+    def update(self, metadata: HPUPagedV2DecodeMetadata) -> None:
+        expected = (
+            self.slot_mapping.shape,
+            self.block_list.shape,
+            self.block_usage.shape,
+            self.block_groups.shape,
+        )
+        actual = (
+            metadata.slot_mapping.shape,
+            metadata.block_list.shape,
+            metadata.block_usage.shape,
+            metadata.block_groups.shape,
+        )
+        if actual != expected:
+            raise ValueError(
+                f"HPU paged-v2 graph metadata shape changed: {actual} != {expected}"
+            )
+        self.slot_mapping.copy_(metadata.slot_mapping)
+        self.block_list.copy_(metadata.block_list)
+        self.block_usage.copy_(metadata.block_usage)
+        self.block_groups.copy_(metadata.block_groups)
+
+    def graph_inputs(self) -> list[torch.Tensor]:
+        return [
+            self.slot_mapping,
+            self.block_list,
+            self.block_usage,
+            self.block_groups,
+        ]
+
+
+def build_blockwise_warmup_shapes(
+    batch_sizes: list[int],
+    block_buckets: tuple[int, ...],
+    max_blocks_per_request: int,
+    *,
+    tail_batch_max: int = 0,
+    tail_max_blocks_per_request: int | None = None,
+) -> list[tuple[int, int]]:
+    shapes: list[tuple[int, int]] = []
+    for batch_size in batch_sizes:
+        blocks_per_request_limit = (
+            tail_max_blocks_per_request
+            if tail_max_blocks_per_request is not None
+            and tail_batch_max > 0
+            and batch_size <= tail_batch_max
+            else max_blocks_per_request
+        )
+        maximum_total = batch_size * blocks_per_request_limit
+        previous_bucket = 0
+        for bucket in block_buckets:
+            minimum_for_bucket = previous_bucket + 1
+            total_blocks = max(batch_size, minimum_for_bucket)
+            if total_blocks <= bucket and total_blocks <= maximum_total:
+                shapes.append((batch_size, total_blocks))
+            previous_bucket = bucket
+    return shapes
+
+
+def ensure_safe_hpu_graph_attention_backend(attn_backend) -> None:
+    if isinstance(attn_backend, HPUBlockwiseAttnBackend):
+        raise RuntimeError(
+            "hpu_blockwise is not numerically safe under full-model HPU decode "
+            "graphs; use hpu_fused or disable decode graphs"
+        )
+    if not isinstance(attn_backend, (HPUFusedAttnBackend, HPUPagedV2AttnBackend)):
+        raise ValueError(
+            "HPU decode graphs require hpu_fused or hpu_paged_v2 attention"
+        )
+
+
+def install_hpu_layer_mark_step_hooks(
+    model,
+    mark_step,
+    interval: int,
+) -> list:
+    """Match vLLM-Gaudi's lazy graph boundary after decoder layers."""
+    if interval <= 0:
+        raise ValueError("HPU layer mark-step interval must be positive")
+
+    handles = []
+    layer_index = 0
+
+    def hook(_module, _args, output):
+        mark_step()
+        return output
+
+    for module in model.modules():
+        if module is model:
+            continue
+        if module.__class__.__name__.endswith(
+            ("DecoderLayer", "EncoderLayer", "BertLayer")
+        ):
+            layer_index += 1
+            if layer_index % interval == 0:
+                handles.append(module.register_forward_hook(hook))
+    if not handles:
+        raise RuntimeError("No transformer layers accepted HPU mark-step hooks")
+    return handles
+
+
+class HPUDecodeGraphRunner:
+    """Capture decode graphs for dense or blockwise HPU attention buckets."""
+
+    def __init__(self, model_runner: ModelRunner, eager_runner: EagerRunner) -> None:
+        import habana_frameworks.torch as htorch
+
+        if os.environ.get("SGLANG_EXPERIMENTAL_HPU_DECODE_GRAPH") != "1":
+            raise RuntimeError(
+                "HPU decode graph capture requires "
+                "SGLANG_EXPERIMENTAL_HPU_DECODE_GRAPH=1."
+            )
+        if not htorch.utils.internal.is_lazy():
+            raise RuntimeError(
+                "HPU decode graphs require PT_HPU_LAZY_MODE=1 and PT_HPU_AUTOLOAD=1"
+            )
+        if model_runner.server_args.pp_size != 1:
+            raise NotImplementedError("HPU decode graphs currently require pp_size=1")
+        if not model_runner.spec_algorithm.is_none():
+            raise NotImplementedError(
+                "HPU decode graphs currently support non-speculative generation only"
+            )
+        ensure_safe_hpu_graph_attention_backend(model_runner.attn_backend)
+
+        self.model_runner = model_runner
+        self.eager_runner = eager_runner
+        self.attn_backend = model_runner.attn_backend
+        self.max_bs = model_runner.server_args.cuda_graph_config.decode.max_bs
+        self._htorch = htorch
+        self._layer_mark_step_handles = []
+        if isinstance(self.attn_backend, HPUPagedV2AttnBackend):
+            interval = int(
+                os.environ.get("SGLANG_HPU_PAGED_V2_MARK_STEP_INTERVAL", "1")
+            )
+            self._layer_mark_step_handles = install_hpu_layer_mark_step_hooks(
+                self.model_runner.model,
+                self._htorch.core.mark_step,
+                interval,
+            )
+            self._adapter = _HPUPagedV2DecodeAdapter(
+                self.model_runner.model,
+                self.attn_backend,
+            )
+        elif isinstance(self.attn_backend, HPUBlockwiseAttnBackend):
+            self._adapter = _HPUBlockwiseDecodeAdapter(
+                self.model_runner.model, self.attn_backend
+            )
+        else:
+            self._adapter = _HPUFusedDecodeAdapter(
+                self.model_runner.model, self.attn_backend
+            )
+        self._graph_model = self._htorch.hpu.wrap_in_hpu_graph(
+            self._adapter,
+            # Replay must publish in-place KV writes to the external cache used
+            # to build the next step's metadata. Retain those tensors when the
+            # graph releases its other cached intermediates.
+            disable_tensor_cache=True,
+            free_inplace=False,
+        )
+        self._initialized_keys: set[tuple[int, int]] = set()
+        self._paged_v2_static_inputs: dict[tuple[int, int], _HPUPagedV2StaticInputs] = (
+            {}
+        )
+        self.warmup_time = 0.0
+        self._warmup_from_environment()
+
+    def _compile_only_context(self):
+        enabled = os.environ.get(
+            "SGLANG_HPU_GRAPH_WARMUP_COMPILE_ONLY", "1"
+        ).lower() in ("1", "true")
+        if not enabled:
+            return contextlib.nullcontext()
+        try:
+            import habana_frameworks.torch.internal.bridge_config as bridge_config
+
+            with bridge_config.env_setting("PT_COMPILE_ONLY_MODE", True):
+                pass
+            logger.info("Using PT_COMPILE_ONLY_MODE for HPU graph warmup")
+            return bridge_config.env_setting("PT_COMPILE_ONLY_MODE", True)
+        except (ImportError, KeyError):
+            logger.warning(
+                "PT_COMPILE_ONLY_MODE is unavailable; HPU graph warmup will execute"
+            )
+            return contextlib.nullcontext()
+
+    def _warmup_batch_sizes(self, configured: list[int]) -> list[int]:
+        if not configured:
+            return []
+        available = tuple(getattr(self.attn_backend, "batch_buckets", ()))
+        if not available:
+            return configured
+        if available[-1] > self.max_bs:
+            raise ValueError("HPU attention batch buckets exceed graph maximum")
+        requested = {select_bucket(value, available) for value in configured}
+        # vLLM-Gaudi warms every scheduler-reachable batch bucket so tail
+        # batches cannot trigger graph compilation during a rollout.
+        return sorted(requested | set(available))
+
+    def _make_dummy_decode_batch(
+        self, batch_size: int, sequence_length: int | list[int]
+    ) -> ForwardBatch:
