+# SPDX-License-Identifier: Apache-2.0
+#
+# The flat paged-attention reduction and metadata layout follow vLLM-Gaudi,
+# Copyright (C) 2024-2026 Intel Corporation. SGLang pool integration is local.
+
+from __future__ import annotations
+
+from dataclasses import dataclass, replace
+import math
+import os
+from typing import TYPE_CHECKING, Optional
+
+import torch
+import torch.nn.functional as F
+
+from sglang.srt.layers.attention.hpu_attention_utils import (
+    generate_hpu_batch_buckets,
+    generate_padding_aware_buckets,
+    maximum_bucket_padding,
+    parse_hpu_batch_buckets,
+    select_bucket,
+)
+from sglang.srt.layers.attention.hpu_blockwise_backend import (
+    _fallback_block_rescale,
+    generate_exponential_buckets,
+    strip_decode_batch_padding,
+)
+from sglang.srt.layers.attention.torch_native_backend import TorchNativeAttnBackend
+from sglang.srt.layers.radix_attention import AttentionType
+
+if TYPE_CHECKING:
+    from sglang.srt.layers.radix_attention import RadixAttention
+    from sglang.srt.model_executor.forward_batch_info import ForwardBatch
+    from sglang.srt.model_executor.model_runner import ModelRunner
+
+
+@dataclass
+class HPUPagedV2DecodeMetadata:
+    batch_size: int
+    padded_batch_size: int
+    num_blocks: int
+    padded_num_blocks: int
+    block_size: int
+    block_list: torch.Tensor
+    block_usage: torch.Tensor
+    block_groups: torch.Tensor
+    slot_mapping: torch.Tensor
+    block_mapping: Optional[torch.Tensor] = None
+    block_bias: Optional[torch.Tensor] = None
+
+
+def materialize_paged_v2_metadata(
+    metadata: HPUPagedV2DecodeMetadata,
+    dtype: torch.dtype,
+) -> HPUPagedV2DecodeMetadata:
+    """Build graph-derived tensors from value-independent metadata shapes."""
+    groups = metadata.block_groups.to(torch.int64)
+    padding_groups = groups < 0
+    block_mapping = F.one_hot(
+        F.relu(groups),
+        num_classes=metadata.padded_batch_size,
+    )
+    block_mapping = block_mapping.masked_fill(padding_groups.view(-1, 1), 0)
+    block_mapping = block_mapping.to(dtype=dtype)
+    positions = torch.arange(
+        metadata.block_size,
+        dtype=metadata.block_usage.dtype,
+        device=metadata.block_usage.device,
+    ).view(1, -1)
+    valid_tokens = positions < metadata.block_usage.view(-1, 1)
+    block_bias = torch.zeros(
+        valid_tokens.shape,
+        dtype=dtype,
+        device=valid_tokens.device,
+    ).masked_fill(~valid_tokens, -math.inf)
+    return replace(
+        metadata,
+        block_mapping=block_mapping,
+        block_bias=block_bias,
+    )
+
+
+def _validate_contiguous_pages(
+    *,
+    req_to_token: torch.Tensor,
+    request_rows: torch.Tensor,
+    block_starts: torch.Tensor,
+    block_usage: torch.Tensor,
+    first_slots: torch.Tensor,
+    block_size: int,
+) -> None:
+    positions = block_starts.view(-1, 1) + torch.arange(
+        block_size,
+        dtype=block_starts.dtype,
+        device=block_starts.device,
+    ).view(1, -1)
+    actual = req_to_token[request_rows.view(-1, 1), positions]
+    expected = first_slots.view(-1, 1) + torch.arange(
+        block_size,
+        dtype=first_slots.dtype,
+        device=first_slots.device,
+    ).view(1, -1)
+    valid = torch.arange(
+        block_size,
+        dtype=block_usage.dtype,
+        device=block_usage.device,
+    ).view(1, -1) < block_usage.view(-1, 1)
+    if not bool(torch.equal(actual[valid], expected[valid])):
+        raise RuntimeError(
+            "hpu_paged_v2 requires each SGLang KV page to occupy contiguous slots"
+        )
+
+
+def build_paged_v2_block_layout(
+    seq_lens_cpu: torch.Tensor,
+    block_size: int,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Vectorize request-to-page metadata construction on the host."""
+    if block_size <= 0:
+        raise ValueError("block_size must be positive")
+    if seq_lens_cpu.device.type != "cpu" or seq_lens_cpu.ndim != 1:
+        raise ValueError("decode sequence lengths must be a CPU vector")
+    sequence_lengths = seq_lens_cpu.to(torch.int64)
+    if sequence_lengths.numel() == 0 or bool(torch.any(sequence_lengths <= 0)):
+        raise ValueError("decode sequence lengths must be positive")
+
+    blocks_per_request = torch.div(
+        sequence_lengths + block_size - 1,
+        block_size,
+        rounding_mode="floor",
+    )
+    block_groups = torch.repeat_interleave(
+        torch.arange(sequence_lengths.numel(), dtype=torch.int64),
+        blocks_per_request,
+    )
+    request_block_offsets = torch.cumsum(blocks_per_request, dim=0) - blocks_per_request
+    request_block_indices = torch.arange(
+        block_groups.numel(), dtype=torch.int64
+    ) - torch.repeat_interleave(request_block_offsets, blocks_per_request)
+    block_starts = request_block_indices * block_size
+    block_usage = torch.minimum(
+        sequence_lengths[block_groups] - block_starts,
+        torch.tensor(block_size, dtype=torch.int64),
+    ).to(torch.int32)
+    return block_groups, block_starts, block_usage
+
+
+def build_paged_v2_decode_metadata(
+    *,
+    req_to_token: torch.Tensor,
+    req_pool_indices: torch.Tensor,
+    seq_lens_cpu: torch.Tensor,
+    out_cache_loc: torch.Tensor,
+    block_size: int,
+    padded_batch_size: int,
+    padded_num_blocks: int,
+    dtype: torch.dtype,
+    validate_pages: bool = False,
+    materialize: bool = True,
+) -> HPUPagedV2DecodeMetadata:
+    if block_size <= 0:
+        raise ValueError("block_size must be positive")
+    batch_size = req_pool_indices.shape[0]
+    if padded_batch_size < batch_size:
+        raise ValueError("padded_batch_size cannot be smaller than batch_size")
+    if out_cache_loc.shape[0] < batch_size:
+        raise ValueError("out_cache_loc cannot be smaller than batch_size")
+
+    if seq_lens_cpu.shape != (batch_size,):
+        raise ValueError(
+            "decode sequence lengths must be positive and match batch_size"
+        )
+    if bool(torch.any(seq_lens_cpu > req_to_token.shape[1])):
+        raise ValueError("decode sequence length exceeds the request-token table")
+
+    block_groups_cpu, block_starts_cpu, block_usage_cpu = build_paged_v2_block_layout(
+        seq_lens_cpu, block_size
+    )
+    num_blocks = block_groups_cpu.numel()
+    if padded_num_blocks < num_blocks:
+        raise ValueError("padded_num_blocks cannot be smaller than num_blocks")
+
+    device = req_to_token.device
+    block_groups_real = block_groups_cpu.to(device=device)
+    block_starts = block_starts_cpu.to(device=device)
+    block_usage_real = block_usage_cpu.to(device=device)
+    request_rows = req_pool_indices[block_groups_real].to(torch.int64)
+    first_slots = req_to_token[request_rows, block_starts].to(torch.int64)
+    if validate_pages:
+        if bool(torch.any(first_slots.remainder(block_size) != 0)):
+            raise RuntimeError(
+                "hpu_paged_v2 requires page-aligned SGLang KV allocations"
+            )
+        _validate_contiguous_pages(
+            req_to_token=req_to_token,
+            request_rows=request_rows,
+            block_starts=block_starts,
+            block_usage=block_usage_real,
+            first_slots=first_slots,
+            block_size=block_size,
+        )
+
+    padding_blocks = padded_num_blocks - num_blocks
+    block_list = F.pad(
+        first_slots // block_size,
+        (0, padding_blocks),
+        value=0,
+    )
+    block_usage = F.pad(
+        block_usage_real,
+        (0, padding_blocks),
+        value=1,
+    )
+    block_groups = F.pad(
+        block_groups_real,
+        (0, padding_blocks),
+        value=-1,
+    )
+    batch_padding = padded_batch_size - batch_size
+    slot_mapping = torch.cat(
+        (
+            out_cache_loc[:batch_size].to(torch.int64),
+            torch.arange(batch_padding, dtype=torch.int64, device=device),
+        )
+    )
+    metadata = HPUPagedV2DecodeMetadata(
+        batch_size=batch_size,
+        padded_batch_size=padded_batch_size,
+        num_blocks=num_blocks,
+        padded_num_blocks=padded_num_blocks,
+        block_size=block_size,
+        block_list=block_list,
+        block_usage=block_usage,
+        block_groups=block_groups,
+        slot_mapping=slot_mapping,
+    )
+    return materialize_paged_v2_metadata(metadata, dtype) if materialize else metadata
+
+
+def paged_v2_decode_attention(
+    query: torch.Tensor,
+    key_cache: torch.Tensor,
+    value_cache: torch.Tensor,
+    metadata: HPUPagedV2DecodeMetadata,
+    scale: float,
+    *,
+    use_hpu_fused_ops: bool = True,
+) -> torch.Tensor:
+    batch_size, query_heads, head_size = query.shape
+    if batch_size != metadata.padded_batch_size:
+        raise ValueError("query batch must match padded paged-attention metadata")
+    if metadata.block_mapping is None or metadata.block_bias is None:
+        raise ValueError("paged-attention metadata was not materialized")
+    if key_cache.shape[0] % metadata.block_size:
+        raise ValueError("key cache token dimension must be page aligned")
+    if value_cache.shape[0] % metadata.block_size:
+        raise ValueError("value cache token dimension must be page aligned")
+
+    key_pages = key_cache.unflatten(0, (-1, metadata.block_size))
+    value_pages = value_cache.unflatten(0, (-1, metadata.block_size))
+    key = key_pages.index_select(0, metadata.block_list).transpose(1, 2)
+    value = value_pages.index_select(0, metadata.block_list).transpose(1, 2)
+    kv_heads = key.shape[1]
+    if query_heads % kv_heads:
+        raise ValueError("query heads must be divisible by KV heads")
+
+    query = torch.matmul(
+        metadata.block_mapping,
+        (query * scale).reshape(batch_size, -1),
+    ).view(metadata.padded_num_blocks, query_heads, 1, head_size)
+    block_bias = metadata.block_bias.view(metadata.padded_num_blocks, 1, 1, -1)
+
+    if query_heads != kv_heads:
+        query = query.unflatten(1, (kv_heads, query_heads // kv_heads))
+        key = key.unflatten(1, (kv_heads, 1))
+        value = value.unflatten(1, (kv_heads, 1))
+        block_bias = block_bias.unsqueeze(2)
+
+    scores = torch.matmul(query, key.transpose(-2, -1))
+    fused_ops_available = (
+        use_hpu_fused_ops
+        and query.device.type == "hpu"
+        and scores.dim() == 5
+        and hasattr(torch.ops.hpu, "block_softmax")
+        and hasattr(torch.ops.hpu, "block_softmax_adjustment")
+    )
+    if fused_ops_available:
+        probabilities, block_max, block_sums = torch.ops.hpu.block_softmax(
+            scores,
+            block_bias,
+            metadata.block_groups,
+        )
+    else:
+        scores = scores + block_bias
+        block_max = scores.amax(dim=-1, keepdim=True)
+        probabilities = (scores - block_max).exp()
+        block_sums = probabilities.sum(dim=-1, keepdim=True)
+
+    block_output = torch.matmul(probabilities, value)
+    if fused_ops_available:
+        out_shape = list(block_output.shape[:3]) + [1] * (block_output.dim() - 3)
+        rescale = torch.ops.hpu.block_softmax_adjustment(
+            block_max,
+            block_sums.to(block_max.dtype),
+            metadata.block_groups,
+            batch_size,
+            out_shape,
+        ).to(block_output.dtype)
+    else:
+        rescale = _fallback_block_rescale(
+            block_max,
+            block_sums,
+            metadata.block_groups,
+            batch_size,
+        )
+    block_output = block_output * rescale
+    output = torch.matmul(
+        metadata.block_mapping.transpose(0, 1),
+        block_output.reshape(metadata.padded_num_blocks, -1),
+    ).view(batch_size, query_heads, head_size)
+    return output
+
+
+class HPUPagedV2AttnBackend(TorchNativeAttnBackend):
+    """Experimental vLLM-style paged decode attention for Gaudi."""
+
+    def __init__(self, model_runner: ModelRunner):
+        if model_runner.device != "hpu":
+            raise ValueError("hpu_paged_v2 attention requires an HPU device")
+        if os.environ.get("SGLANG_EXPERIMENTAL_HPU_PAGED_V2") != "1":
+            raise RuntimeError(
+                "hpu_paged_v2 requires SGLANG_EXPERIMENTAL_HPU_PAGED_V2=1"
+            )
+        super().__init__(model_runner)
+        if model_runner.dtype != torch.bfloat16:
+            raise ValueError("hpu_paged_v2 currently requires BF16 weights")
+        if self.token_to_kv_pool.store_dtype != torch.bfloat16:
+            raise ValueError("hpu_paged_v2 currently requires a BF16 KV cache")
+
+        self.batch_bucket_step = int(
+            os.environ.get("SGLANG_HPU_DECODE_BATCH_BUCKET_STEP", "32")
+        )
+        self.block_size = int(os.environ.get("SGLANG_HPU_PAGED_V2_BLOCK_SIZE", "128"))
+        self.block_bucket_limit = int(
+            os.environ.get("SGLANG_HPU_BLOCK_BUCKET_LIMIT", "16")
+        )
+        self.block_bucket_step = int(
+            os.environ.get("SGLANG_HPU_DECODE_BLOCK_BUCKET_STEP", "32")
+        )
+        self.bucket_padding_max = int(os.environ.get("SGLANG_HPU_BUCKET_PAD_MAX", "0"))
+        self.bucket_padding_percent = int(
+            os.environ.get("SGLANG_HPU_BUCKET_PAD_PERCENT", "25")
+        )
+        self.bucketing_strategy = os.environ.get(
+            "SGLANG_HPU_BUCKETING_STRATEGY", "exp"
+        ).lower()
+        if (
+            min(
+                self.batch_bucket_step,
+                self.block_size,
+                self.block_bucket_limit,
+                self.block_bucket_step,
+            )
+            <= 0
+        ):
+            raise ValueError("HPU paged-v2 bucket settings must be positive")
+        if self.batch_bucket_step > self.block_size:
+            raise ValueError(
+                "hpu_paged_v2 requires the decode batch bucket step to fit in "
+                "the reserved KV padding page"
+            )
+        if model_runner.page_size != self.block_size:
+            raise ValueError(
+                "hpu_paged_v2 requires --page-size to match "
+                f"SGLANG_HPU_PAGED_V2_BLOCK_SIZE ({self.block_size})"
+            )
+        if self.token_to_kv_pool.page_size != self.block_size:
+            raise ValueError("hpu_paged_v2 requires a page-aligned KV pool")
+        if getattr(self.token_to_kv_pool, "kv_cache_layout", "nhd") != "nhd":
+            raise ValueError("hpu_paged_v2 currently requires the NHD KV layout")
+        self.token_to_kv_pool_allocator = model_runner.token_to_kv_pool_allocator
+        self.max_context_length = model_runner.model_config.context_len
+        self.max_bs = model_runner.server_args.cuda_graph_config.decode.max_bs
+        max_blocks = min(
+            self.max_bs * math.ceil(self.max_context_length / self.block_size),
+            self.token_to_kv_pool.size // self.block_size,
+        )
+        explicit_batch_buckets = os.environ.get("SGLANG_HPU_DECODE_BATCH_BUCKETS")
+        self.batch_buckets = (
+            parse_hpu_batch_buckets(explicit_batch_buckets, self.max_bs)
+            if explicit_batch_buckets
+            else generate_hpu_batch_buckets(
+                self.max_bs,
+                self.batch_bucket_step,
+                strategy=self.bucketing_strategy,
+                max_padding=self.bucket_padding_max,
+                max_padding_percent=self.bucket_padding_percent,
+            )
+        )
+        if maximum_bucket_padding(self.batch_buckets) > self.block_size:
+            raise ValueError(
+                "hpu_paged_v2 decode batch buckets can pad by at most one "
+                "reserved KV page"
+            )
+        if self.bucketing_strategy == "pad":
+            self.block_buckets = generate_padding_aware_buckets(
+                1,
+                self.block_bucket_step,
+                max_blocks,
+                max_padding=self.bucket_padding_max or math.ceil(max_blocks / 4),
+                max_padding_percent=self.bucket_padding_percent,
+            )
+        else:
+            self.block_buckets = generate_exponential_buckets(
+                max_blocks,
+                self.block_bucket_limit,
+            )
+        self.forward_metadata: Optional[HPUPagedV2DecodeMetadata] = None
+
+    def init_forward_metadata(
+        self,
+        forward_batch: ForwardBatch,
+        *,
+        materialize: bool = True,
+    ):
+        super().init_forward_metadata(forward_batch)
+        self.forward_metadata = None
+        if not forward_batch.forward_mode.is_decode():
+            return
+        if forward_batch.seq_lens_cpu is None:
+            raise ValueError("hpu_paged_v2 decode requires CPU sequence lengths")
+
+        req_pool_indices, seq_lens_cpu = strip_decode_batch_padding(
+            forward_batch.req_pool_indices,
+            forward_batch.seq_lens_cpu,
+        )
+        batch_size = req_pool_indices.shape[0]
+        padded_batch_size = select_bucket(
+            forward_batch.batch_size,
+            self.batch_buckets,
+        )
+        num_blocks = int(
+            torch.div(
+                seq_lens_cpu.to(torch.int64) + self.block_size - 1,
+                self.block_size,
+                rounding_mode="floor",
+            )
+            .sum()
+            .item()
+        )
+        padded_num_blocks = select_bucket(num_blocks, self.block_buckets)
+        self.forward_metadata = build_paged_v2_decode_metadata(
+            req_to_token=self.req_to_token_pool.req_to_token,
+            req_pool_indices=req_pool_indices,
+            seq_lens_cpu=seq_lens_cpu,
+            out_cache_loc=forward_batch.out_cache_loc[:batch_size],
+            block_size=self.block_size,
+            padded_batch_size=padded_batch_size,
+            padded_num_blocks=padded_num_blocks,
+            dtype=torch.bfloat16,
+            validate_pages=(
+                os.environ.get("SGLANG_HPU_PAGED_V2_VALIDATE_PAGES") == "1"
+            ),
+            materialize=materialize,
+        )
+
+    def forward_decode(
+        self,
+        q,
+        k,
+        v,
+        layer: RadixAttention,
+        forward_batch: ForwardBatch,
+        save_kv_cache=True,
+    ):
+        if (
+            layer.is_cross_attention
+            or layer.attn_type != AttentionType.DECODER
+            or layer.sliding_window_size > -1
+            or q.dtype != torch.bfloat16
+            or layer.qk_head_dim != layer.v_head_dim
+            or layer.tp_q_head_num == layer.tp_k_head_num
+        ):
+            return super().forward_decode(q, k, v, layer, forward_batch, save_kv_cache)
+
+        metadata = self.forward_metadata
+        if metadata is None:
+            raise RuntimeError("hpu_paged_v2 decode metadata was not initialized")
+
+        q = q.reshape(-1, layer.tp_q_head_num, layer.qk_head_dim)
+        key_cache = self.token_to_kv_pool.get_key_buffer(layer.layer_id)
+        value_cache = self.token_to_kv_pool.get_value_buffer(layer.layer_id)
+        if save_kv_cache and k is not None and v is not None:
+            k = k.reshape(-1, key_cache.shape[1], key_cache.shape[2])
+            v = v.reshape(-1, value_cache.shape[1], value_cache.shape[2])
+            write_padding = metadata.padded_batch_size - k.shape[0]
+            if write_padding:
+                k = F.pad(k, (0, 0, 0, 0, 0, write_padding))
+                v = F.pad(v, (0, 0, 0, 0, 0, write_padding))
+            key_cache.index_copy_(0, metadata.slot_mapping, k)
+            value_cache.index_copy_(0, metadata.slot_mapping, v)
+
+        batch_padding = metadata.padded_batch_size - metadata.batch_size
+        if batch_padding:
+            q = F.pad(q, (0, 0, 0, 0, 0, batch_padding))
+        output = paged_v2_decode_attention(
+            q,
+            key_cache,
+            value_cache,
+            metadata,
+            layer.scaling,
+        )
+        output = output[: metadata.batch_size]
+        return output.reshape(metadata.batch_size, -1)
