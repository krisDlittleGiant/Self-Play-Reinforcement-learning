+            padded_batch_size=1,
+            padded_num_blocks=1,
+            dtype=torch.float32,
+            validate_pages=True,
+        )
+
+
+@pytest.mark.parametrize("query_heads,kv_heads", [(4, 2), (4, 1)])
+def test_paged_v2_attention_matches_dense_attention(query_heads, kv_heads):
+    torch.manual_seed(1234)
+    block_size = 4
+    head_size = 8
+    lengths = [5, 7]
+    req_to_token = _page_aligned_request_table()
+    req_pool_indices = torch.tensor([2, 5], dtype=torch.int64)
+    key_cache = torch.randn(40, kv_heads, head_size)
+    value_cache = torch.randn_like(key_cache)
+    query = torch.randn(2, query_heads, head_size)
+    scale = 1.0 / math.sqrt(head_size)
+
+    metadata = build_paged_v2_decode_metadata(
+        req_to_token=req_to_token,
+        req_pool_indices=req_pool_indices,
+        seq_lens_cpu=torch.tensor(lengths, dtype=torch.int32),
+        out_cache_loc=torch.tensor([16, 30], dtype=torch.int64),
+        block_size=block_size,
+        padded_batch_size=4,
+        padded_num_blocks=6,
+        dtype=query.dtype,
+        validate_pages=True,
+    )
+    actual = paged_v2_decode_attention(
+        F.pad(query, (0, 0, 0, 0, 0, 2)),
+        key_cache,
+        value_cache,
+        metadata,
+        scale,
+        use_hpu_fused_ops=False,
+    )[:2]
+
+    expected = []
+    for request, length in enumerate(lengths):
+        slots = req_to_token[req_pool_indices[request], :length].to(torch.int64)
+        key = key_cache[slots].transpose(0, 1).unsqueeze(0)
+        value = value_cache[slots].transpose(0, 1).unsqueeze(0)
+        output = F.scaled_dot_product_attention(
+            query[request].unsqueeze(0).unsqueeze(2),
+            key,
+            value,
+            dropout_p=0.0,
+            is_causal=False,
+            scale=scale,
+            enable_gqa=True,
+        )
+        expected.append(output.squeeze(0).squeeze(1))
