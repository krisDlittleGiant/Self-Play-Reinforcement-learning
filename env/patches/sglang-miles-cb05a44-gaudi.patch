+from __future__ import annotations
+
+from dataclasses import dataclass
+import os
+from typing import TYPE_CHECKING, Optional
+
+import torch
+import torch.nn.functional as F
+from habana_frameworks.torch.hpex.kernels import FusedSDPA
+
+from sglang.srt.layers.attention.hpu_attention_utils import (
+    generate_hpu_batch_buckets,
+    parse_hpu_batch_buckets,
+    round_up,
+    select_bucket,
+)
+from sglang.srt.layers.attention.torch_native_backend import TorchNativeAttnBackend
+from sglang.srt.layers.radix_attention import AttentionType
+from sglang.srt.mem_cache.memory_pool import KVWriteLoc
+
+if TYPE_CHECKING:
+    from sglang.srt.layers.radix_attention import RadixAttention
+    from sglang.srt.model_executor.forward_batch_info import ForwardBatch
+    from sglang.srt.model_executor.model_runner import ModelRunner
+
+
+@dataclass
+class HPUFusedDecodeMetadata:
+    batch_size: int
+    padded_batch_size: int
+    token_indices: torch.Tensor
+    attention_mask: torch.Tensor
+
+
+class HPUFusedAttnBackend(TorchNativeAttnBackend):
+    """Dependency-free Habana FusedSDPA backend for decode attention.
+
+    Prefill and unsupported attention modes retain TorchNativeAttnBackend's
+    behavior. Decode gathers each request's KV sequence into a padded dense
+    batch, replacing the torch-native backend's Python loop over requests.
+    """
+
+    def __init__(self, model_runner: ModelRunner):
+        if model_runner.device != "hpu":
+            raise ValueError("hpu_fused attention requires an HPU device")
+        super().__init__(model_runner)
+        if model_runner.dtype != torch.bfloat16:
+            raise ValueError(
+                "hpu_fused attention currently requires BF16 model weights"
+            )
+        if self.token_to_kv_pool.store_dtype != torch.bfloat16:
+            raise ValueError("hpu_fused attention currently requires a BF16 KV cache")
+        self.batch_bucket_step = int(
+            os.environ.get("SGLANG_HPU_DECODE_BATCH_BUCKET_STEP", "32")
+        )
+        self.sequence_bucket_step = int(
+            os.environ.get("SGLANG_HPU_DENSE_DECODE_SEQ_BUCKET_STEP", "128")
+        )
+        if self.batch_bucket_step <= 0 or self.sequence_bucket_step <= 0:
+            raise ValueError("HPU decode bucket steps must be positive")
+        self.max_context_length = model_runner.model_config.context_len
+        self.max_bs = model_runner.server_args.cuda_graph_config.decode.max_bs
+        self.bucketing_strategy = os.environ.get(
+            "SGLANG_HPU_BUCKETING_STRATEGY", "exp"
+        ).lower()
+        explicit_batch_buckets = os.environ.get("SGLANG_HPU_DECODE_BATCH_BUCKETS")
+        self.batch_buckets = (
+            parse_hpu_batch_buckets(explicit_batch_buckets, self.max_bs)
+            if explicit_batch_buckets
+            else generate_hpu_batch_buckets(
+                self.max_bs,
+                self.batch_bucket_step,
+                strategy=self.bucketing_strategy,
+                max_padding=int(os.environ.get("SGLANG_HPU_BUCKET_PAD_MAX", "0")),
+                max_padding_percent=int(
+                    os.environ.get("SGLANG_HPU_BUCKET_PAD_PERCENT", "25")
+                ),
+            )
+        )
+        self.positions = torch.arange(
+            self.max_context_length, dtype=torch.int32, device=self.device
+        )
+        self.forward_metadata: Optional[HPUFusedDecodeMetadata] = None
+
+    def init_forward_metadata(self, forward_batch: ForwardBatch):
+        super().init_forward_metadata(forward_batch)
+        self.forward_metadata = None
+        if not forward_batch.forward_mode.is_decode():
+            return
+        if forward_batch.seq_lens_cpu is None:
+            raise ValueError("hpu_fused decode requires the CPU sequence-length mirror")
+
+        batch_size = forward_batch.batch_size
+        padded_batch_size = select_bucket(batch_size, self.batch_buckets)
+        max_sequence_length = int(forward_batch.seq_lens_cpu.max())
+        sequence_bucket = round_up(max_sequence_length, self.sequence_bucket_step)
+        if sequence_bucket > self.max_context_length:
+            raise ValueError(
+                f"HPU decode sequence bucket {sequence_bucket} exceeds context "
+                f"length {self.max_context_length}"
+            )
+
+        batch_padding = padded_batch_size - batch_size
+        request_indices = F.pad(
+            forward_batch.req_pool_indices, (0, batch_padding), value=0
+        )
+        sequence_lengths = F.pad(forward_batch.seq_lens, (0, batch_padding), value=1)
+        token_indices = self.req_to_token_pool.req_to_token[
+            request_indices, :sequence_bucket
+        ]
+        valid_tokens = self.positions[:sequence_bucket].view(1, 1, 1, -1) < (
+            sequence_lengths.view(-1, 1, 1, 1)
+        )
+        attention_mask = torch.zeros(
+            valid_tokens.shape,
+            dtype=torch.bfloat16,
+            device=self.device,
+        ).masked_fill(~valid_tokens, torch.finfo(torch.bfloat16).min)
+        self.forward_metadata = HPUFusedDecodeMetadata(
+            batch_size=batch_size,
+            padded_batch_size=padded_batch_size,
+            token_indices=token_indices,
+            attention_mask=attention_mask,
+        )
+
+    def forward_decode(
+        self,
+        q,
+        k,
+        v,
+        layer: RadixAttention,
+        forward_batch: ForwardBatch,
+        save_kv_cache=True,
+    ):
+        if (
+            layer.is_cross_attention
+            or layer.attn_type != AttentionType.DECODER
+            or layer.sliding_window_size > -1
+            or q.dtype != torch.bfloat16
+            or layer.qk_head_dim != layer.v_head_dim
+        ):
+            return super().forward_decode(q, k, v, layer, forward_batch, save_kv_cache)
+
+        metadata = self.forward_metadata
+        if metadata is None:
+            raise RuntimeError("hpu_fused decode metadata was not initialized")
+
+        q = q.reshape(-1, layer.tp_q_head_num, layer.qk_head_dim)
+        if save_kv_cache and k is not None and v is not None:
+            self.token_to_kv_pool.set_kv_buffer(
+                layer,
+                KVWriteLoc(forward_batch.out_cache_loc, self.swa_out_cache_loc),
+                k,
+                v,
+            )
+
+        batch_padding = metadata.padded_batch_size - metadata.batch_size
+        if batch_padding:
+            q = F.pad(q, (0, 0, 0, 0, 0, batch_padding))
+
+        key = self.token_to_kv_pool.get_key_buffer(layer.layer_id)[
+            metadata.token_indices
+        ].permute(0, 2, 1, 3)
+        value = self.token_to_kv_pool.get_value_buffer(layer.layer_id)[
+            metadata.token_indices
+        ].permute(0, 2, 1, 3)
+        output = FusedSDPA.apply(
+            q.unsqueeze(2),
+            key,
+            value,
+            metadata.attention_mask,
+            0.0,
+            False,
+            layer.scaling,
+        )
+        output = output[: metadata.batch_size].squeeze(2)
+        return output.reshape(metadata.batch_size, -1)
