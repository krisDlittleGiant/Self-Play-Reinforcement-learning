diff --git a/benchmark/hpu_paged_v2_replay.py b/benchmark/hpu_paged_v2_replay.py
new file mode 100644
index 0000000000..62bb26dd37
--- /dev/null
+++ b/benchmark/hpu_paged_v2_replay.py
@@ -0,0 +1,266 @@
+"""Validate multi-step paged-attention and KV writes under an HPU graph."""
+
+from __future__ import annotations
+
+import argparse
+import math
+import os
+
+import habana_frameworks.torch as htorch
+import torch
+
+from sglang.srt.layers.attention.hpu_paged_v2_backend import (
+    HPUPagedV2DecodeMetadata,
+    build_paged_v2_decode_metadata,
+    materialize_paged_v2_metadata,
+    paged_v2_decode_attention,
+)
+
+
+class PagedReplayStack(torch.nn.Module):
+    def __init__(
+        self,
+        *,
+        block_size: int,
+        batch_size: int,
+        scale: float,
+        layers: int,
+        mark_step_interval: int,
+    ) -> None:
+        super().__init__()
+        self.block_size = block_size
+        self.batch_size = batch_size
+        self.scale = scale
+        self.layers = layers
+        self.mark_step_interval = mark_step_interval
+
+    def forward(
+        self,
+        query: torch.Tensor,
+        new_key: torch.Tensor,
+        new_value: torch.Tensor,
+        key_cache: torch.Tensor,
+        value_cache: torch.Tensor,
+        slot_mapping: torch.Tensor,
+        block_list: torch.Tensor,
+        block_usage: torch.Tensor,
+        block_groups: torch.Tensor,
+    ) -> torch.Tensor:
+        metadata = materialize_paged_v2_metadata(
+            HPUPagedV2DecodeMetadata(
+                batch_size=self.batch_size,
+                padded_batch_size=self.batch_size,
+                num_blocks=block_list.shape[0],
+                padded_num_blocks=block_list.shape[0],
+                block_size=self.block_size,
+                block_list=block_list,
+                block_usage=block_usage,
+                block_groups=block_groups,
+                slot_mapping=slot_mapping,
+            ),
+            query.dtype,
+        )
+        output = query
+        for layer in range(self.layers):
+            key_cache[layer].index_copy_(0, slot_mapping, new_key[layer])
+            value_cache[layer].index_copy_(0, slot_mapping, new_value[layer])
+            output = paged_v2_decode_attention(
+                output,
+                key_cache[layer],
+                value_cache[layer],
+                metadata,
+                self.scale,
+            )
+            if (layer + 1) % self.mark_step_interval == 0:
+                htorch.core.mark_step()
+        return output
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--batch-size", type=int, default=8)
+    parser.add_argument("--initial-sequence-length", type=int, default=129)
+    parser.add_argument("--steps", type=int, default=32)
+    parser.add_argument("--layers", type=int, default=4)
+    parser.add_argument("--query-heads", type=int, default=16)
+    parser.add_argument("--kv-heads", type=int, default=2)
+    parser.add_argument("--head-dim", type=int, default=128)
+    parser.add_argument("--block-size", type=int, default=128)
+    parser.add_argument("--mark-step-interval", type=int, default=1)
+    parser.add_argument("--seed", type=int, default=1234)
+    return parser.parse_args()
+
+
+def validate_args(args: argparse.Namespace) -> None:
+    for name, value in vars(args).items():
+        if name != "seed" and value <= 0:
+            raise ValueError(f"--{name.replace('_', '-')} must be positive")
+    if args.query_heads % args.kv_heads:
+        raise ValueError("--query-heads must be divisible by --kv-heads")
+    if os.environ.get("PT_HPU_LAZY_MODE") != "1":
+        raise RuntimeError("This harness requires PT_HPU_LAZY_MODE=1")
+    if not torch.hpu.is_available():
+        raise RuntimeError("No Gaudi HPU is available")
+
+
+def build_request_table(args: argparse.Namespace, device: torch.device):
+    max_length = args.initial_sequence_length + args.steps - 1
+    pages_per_request = math.ceil(max_length / args.block_size)
+    tokens_per_request = pages_per_request * args.block_size
+    total_tokens = args.batch_size * tokens_per_request
+    rows = torch.arange(
+        total_tokens,
+        dtype=torch.int32,
+        device=device,
+    ).view(args.batch_size, tokens_per_request)
+    return rows, total_tokens
+
+
+def main() -> None:
+    args = parse_args()
+    validate_args(args)
+    torch.manual_seed(args.seed)
+    device = torch.device("hpu")
+    dtype = torch.bfloat16
+    request_table, total_tokens = build_request_table(args, device)
+    req_pool_indices = torch.arange(args.batch_size, device=device)
+    max_length = args.initial_sequence_length + args.steps - 1
+    max_blocks = args.batch_size * math.ceil(max_length / args.block_size)
+    cache_shape = (
+        args.layers,
+        total_tokens,
+        args.kv_heads,
+        args.head_dim,
+    )
+    initial_key_cache = torch.randn(cache_shape, dtype=dtype, device=device)
+    initial_value_cache = torch.randn_like(initial_key_cache)
+    graph_key_cache = initial_key_cache.clone()
+    graph_value_cache = initial_value_cache.clone()
+    eager_key_cache = initial_key_cache.clone()
+    eager_value_cache = initial_value_cache.clone()
+
+    module_kwargs = {
+        "block_size": args.block_size,
+        "batch_size": args.batch_size,
+        "scale": 1.0 / math.sqrt(args.head_dim),
+        "layers": args.layers,
+        "mark_step_interval": args.mark_step_interval,
+    }
+    eager_module = PagedReplayStack(**module_kwargs).to(device)
+    graph_module = htorch.hpu.wrap_in_hpu_graph(
+        PagedReplayStack(**module_kwargs).to(device),
+        disable_tensor_cache=True,
+        free_inplace=False,
+    )
+
+    static_metadata = None
+    max_output_diff = 0.0
+    with torch.inference_mode():
+        for step in range(args.steps):
+            length = args.initial_sequence_length + step
+            lengths_cpu = torch.full(
+                (args.batch_size,),
+                length,
+                dtype=torch.int32,
+            )
+            slots = request_table[:, length - 1].to(torch.int64)
+            metadata = build_paged_v2_decode_metadata(
+                req_to_token=request_table,
+                req_pool_indices=req_pool_indices,
+                seq_lens_cpu=lengths_cpu,
+                out_cache_loc=slots,
+                block_size=args.block_size,
+                padded_batch_size=args.batch_size,
+                padded_num_blocks=max_blocks,
+                dtype=dtype,
+                validate_pages=(step == 0),
+            )
+            if static_metadata is None:
+                static_metadata = {
+                    "slot_mapping": torch.empty_like(metadata.slot_mapping),
+                    "block_list": torch.empty_like(metadata.block_list),
+                    "block_usage": torch.empty_like(metadata.block_usage),
+                    "block_groups": torch.empty_like(metadata.block_groups),
+                }
+            for name in static_metadata:
+                static_metadata[name].copy_(getattr(metadata, name))
+
+            query = torch.randn(
+                args.batch_size,
+                args.query_heads,
+                args.head_dim,
+                dtype=dtype,
+                device=device,
+            )
+            new_key = torch.randn(
+                args.layers,
+                args.batch_size,
+                args.kv_heads,
+                args.head_dim,
+                dtype=dtype,
+                device=device,
+            )
+            new_value = torch.randn_like(new_key)
+            htorch.core.mark_step()
+            graph_output = graph_module(
+                query,
+                new_key,
+                new_value,
+                graph_key_cache,
+                graph_value_cache,
+                static_metadata["slot_mapping"],
+                static_metadata["block_list"],
+                static_metadata["block_usage"],
+                static_metadata["block_groups"],
+                cache_tensors_list=[graph_key_cache, graph_value_cache],
+            )
+            htorch.core.mark_step()
+            torch.hpu.synchronize()
+            eager_output = eager_module(
+                query,
+                new_key,
+                new_value,
+                eager_key_cache,
+                eager_value_cache,
+                metadata.slot_mapping,
+                metadata.block_list,
+                metadata.block_usage,
+                metadata.block_groups,
+            )
+            htorch.core.mark_step()
+            torch.hpu.synchronize()
+
+            graph_cpu = graph_output.float().cpu()
+            eager_cpu = eager_output.float().cpu()
+            if not bool(torch.isfinite(graph_cpu).all()):
+                raise AssertionError(f"graph output became non-finite at step {step}")
+            output_diff = float((graph_cpu - eager_cpu).abs().max())
+            max_output_diff = max(max_output_diff, output_diff)
+            torch.testing.assert_close(graph_cpu, eager_cpu, rtol=0.03, atol=0.03)
+            for layer in range(args.layers):
+                torch.testing.assert_close(
+                    graph_key_cache[layer, slots].float().cpu(),
+                    eager_key_cache[layer, slots].float().cpu(),
+                    rtol=0,
+                    atol=0,
+                )
+                torch.testing.assert_close(
+                    graph_value_cache[layer, slots].float().cpu(),
+                    eager_value_cache[layer, slots].float().cpu(),
+                    rtol=0,
+                    atol=0,
+                )
+            print(
+                f"step={step + 1:03d} length={length:04d} "
+                f"max_abs_diff={output_diff:.6f} PASS"
+            )
+
+    print(
+        "HPU paged-v2 replay PASS: "
+        f"steps={args.steps}, layers={args.layers}, "
+        f"max_abs_diff={max_output_diff:.6f}"
+    )
+
+
+if __name__ == "__main__":
+    main()
