+
+def _page_aligned_request_table():
+    req_to_token = torch.zeros(8, 8, dtype=torch.int32)
+    req_to_token[2, :5] = torch.tensor([8, 9, 10, 11, 16])
+    req_to_token[5, :7] = torch.tensor([20, 21, 22, 23, 28, 29, 30])
+    return req_to_token
+
+
+def test_paged_v2_backend_does_not_dispatch_triton():
+    assert not support_triton("hpu_paged_v2")
+
+
+def test_paged_v2_block_layout_is_vectorized_and_request_ordered():
+    groups, starts, usage = build_paged_v2_block_layout(
+        torch.tensor([1, 5, 8, 9], dtype=torch.int32),
+        block_size=4,
+    )
+
+    torch.testing.assert_close(groups, torch.tensor([0, 1, 1, 2, 2, 3, 3, 3]))
+    torch.testing.assert_close(starts, torch.tensor([0, 0, 4, 0, 4, 0, 4, 8]))
+    torch.testing.assert_close(
+        usage,
+        torch.tensor([1, 4, 1, 4, 4, 4, 4, 1], dtype=torch.int32),
+    )
+
+
+def test_paged_v2_metadata_uses_physical_pages_and_padding_sentinels():
+    metadata = build_paged_v2_decode_metadata(
+        req_to_token=_page_aligned_request_table(),
+        req_pool_indices=torch.tensor([2, 5], dtype=torch.int64),
+        seq_lens_cpu=torch.tensor([5, 7], dtype=torch.int32),
+        out_cache_loc=torch.tensor([16, 30], dtype=torch.int64),
+        block_size=4,
+        padded_batch_size=4,
+        padded_num_blocks=6,
+        dtype=torch.float32,
+        validate_pages=True,
+    )
+
+    torch.testing.assert_close(
+        metadata.block_list,
+        torch.tensor([2, 4, 5, 7, 0, 0], dtype=torch.int64),
+    )
+    torch.testing.assert_close(
+        metadata.block_usage,
+        torch.tensor([4, 1, 4, 3, 1, 1], dtype=torch.int32),
+    )
+    torch.testing.assert_close(
+        metadata.block_groups,
+        torch.tensor([0, 0, 1, 1, -1, -1], dtype=torch.int64),
+    )
+    torch.testing.assert_close(
+        metadata.slot_mapping,
+        torch.tensor([16, 30, 0, 1], dtype=torch.int64),
+    )
+    assert metadata.block_mapping.shape == (6, 4)
+    assert not metadata.block_mapping[4:].any()
+    assert metadata.block_bias.shape == (6, 4)
+
+
+def test_paged_v2_metadata_can_defer_graph_derived_tensors():
+    metadata = build_paged_v2_decode_metadata(
+        req_to_token=_page_aligned_request_table(),
+        req_pool_indices=torch.tensor([2, 5], dtype=torch.int64),
+        seq_lens_cpu=torch.tensor([5, 7], dtype=torch.int32),
+        out_cache_loc=torch.tensor([16, 30], dtype=torch.int64),
+        block_size=4,
+        padded_batch_size=4,
+        padded_num_blocks=6,
+        dtype=torch.float32,
+        materialize=False,
+    )
+
+    assert metadata.block_mapping is None
+    assert metadata.block_bias is None
+    torch.testing.assert_close(
+        metadata.block_list,
+        torch.tensor([2, 4, 5, 7, 0, 0], dtype=torch.int64),
+    )
+    torch.testing.assert_close(
+        metadata.slot_mapping,
+        torch.tensor([16, 30, 0, 1], dtype=torch.int64),
+    )
+
+
+def test_paged_v2_metadata_validation_rejects_fragmented_page():
+    req_to_token = _page_aligned_request_table()
+    req_to_token[2, 3] = 14
+
+    with pytest.raises(RuntimeError, match="contiguous slots"):
+        build_paged_v2_decode_metadata(
+            req_to_token=req_to_token,
+            req_pool_indices=torch.tensor([2], dtype=torch.int64),
+            seq_lens_cpu=torch.tensor([4], dtype=torch.int32),
