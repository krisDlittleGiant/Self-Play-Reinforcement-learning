index 0000000000..18eda8f2f4
--- /dev/null
+++ b/python/sglang/srt/layers/attention/hpu_attention_utils.py
@@ -0,0 +1,129 @@
+from __future__ import annotations
+
+import math
+
+
+def round_up(value: int, step: int) -> int:
+    return (value + step - 1) // step * step
+
+
+def batch_bucket(batch_size: int, step: int) -> int:
+    if batch_size >= step:
+        return round_up(batch_size, step)
+    bucket = 1
+    while bucket < batch_size:
+        bucket *= 2
+    return bucket
+
+
+def select_bucket(value: int, buckets: tuple[int, ...]) -> int:
+    if value <= 0:
+        raise ValueError("value must be positive")
+    for bucket in buckets:
+        if value <= bucket:
+            return bucket
+    return value
+
+
+def parse_hpu_batch_buckets(config: str, maximum: int) -> tuple[int, ...]:
+    """Parse an explicit, complete HPU decode batch-bucket lattice."""
+    try:
+        buckets = tuple(int(value.strip()) for value in config.split(","))
+    except ValueError as exc:
+        raise ValueError(
+            "HPU decode batch buckets must be comma-separated integers"
+        ) from exc
+    if not buckets or any(bucket <= 0 for bucket in buckets):
+        raise ValueError("HPU decode batch buckets must be positive")
+    if buckets != tuple(sorted(set(buckets))):
+        raise ValueError("HPU decode batch buckets must be unique and increasing")
+    if buckets[0] != 1 or buckets[-1] != maximum:
+        raise ValueError(
+            "HPU decode batch buckets must start at 1 and end at the decode graph maximum"
+        )
+    return buckets
+
+
+def maximum_bucket_padding(buckets: tuple[int, ...]) -> int:
+    """Return the largest number of rows padded by a complete bucket lattice."""
+    if not buckets or buckets[0] <= 0:
+        raise ValueError("HPU decode batch buckets must be positive")
+    if buckets != tuple(sorted(set(buckets))):
+        raise ValueError("HPU decode batch buckets must be unique and increasing")
+
+    previous = 0
+    maximum = 0
+    for bucket in buckets:
+        maximum = max(maximum, bucket - previous - 1)
+        previous = bucket
+    return maximum
+
+
+def generate_padding_aware_buckets(
+    minimum: int,
+    step: int,
+    maximum: int,
+    *,
+    max_padding: int,
+    max_padding_percent: int,
+) -> tuple[int, ...]:
+    """Generate vLLM-Gaudi-style buckets with bounded padding overhead."""
+    if minimum <= 0 or step <= 0 or maximum < minimum:
+        raise ValueError("invalid padding-aware bucket range")
+    if max_padding < 0:
+        raise ValueError("max_padding must be non-negative")
+    if not 0 <= max_padding_percent <= 50:
+        raise ValueError("max_padding_percent must be between 0 and 50")
+
+    effective_max_padding = max_padding or maximum
+    buckets = [minimum]
+    current = minimum
+    while current <= maximum:
+        previous = buckets[-1]
+        if current <= step:
+            next_value = previous * 2
+            if next_value <= maximum:
+                buckets.append(next_value)
+        else:
+            next_value = current + step
+            padding = next_value - previous - 1
+            padding_ratio = padding / next_value
+            keep = (
+                padding_ratio > max_padding_percent / 100.0
+                or padding > effective_max_padding
+                or current % effective_max_padding == 0
+            )
+            if keep and current != previous:
+                buckets.append(current)
+        current = next_value
+
+    if buckets[-1] != maximum:
+        buckets.append(maximum)
+    return tuple(buckets)
+
+
+def generate_hpu_batch_buckets(
+    maximum: int,
+    step: int,
+    *,
+    strategy: str,
+    max_padding: int = 0,
+    max_padding_percent: int = 25,
+) -> tuple[int, ...]:
+    if maximum <= 0 or step <= 0:
+        raise ValueError("HPU batch bucket bounds must be positive")
+    if strategy == "pad":
+        return generate_padding_aware_buckets(
+            1,
+            step,
+            maximum,
+            max_padding=max_padding or math.ceil(maximum / 4),
+            max_padding_percent=max_padding_percent,
+        )
+    if strategy == "exp":
+        return tuple(
+            sorted(
+                {batch_bucket(batch_size, step) for batch_size in range(1, maximum + 1)}
+            )
+        )
+    raise ValueError("HPU bucketing strategy must be 'exp' or 'pad'")
diff --git a/python/sglang/srt/layers/attention/hpu_blockwise_backend.py b/python/sglang/srt/layers/attention/hpu_blockwise_backend.py
new file mode 100644
index 0000000000..321bd4c102
--- /dev/null
+++ b/python/sglang/srt/layers/attention/hpu_blockwise_backend.py
@@ -0,0 +1,424 @@
+# SPDX-License-Identifier: Apache-2.0
+#
+# The grouped online-softmax reduction follows the flat paged-attention
+# algorithm from vLLM-Gaudi, Copyright (C) 2024-2025 Intel Corporation.
+# SGLang-specific metadata and KV-pool integration are implemented here.
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+import math
+import os
+from typing import TYPE_CHECKING, Optional
+
+import torch
+import torch.nn.functional as F
+
+from sglang.srt.layers.attention.hpu_attention_utils import (
+    generate_hpu_batch_buckets,
+    generate_padding_aware_buckets,
+    parse_hpu_batch_buckets,
+    select_bucket,
+)
+from sglang.srt.layers.attention.torch_native_backend import TorchNativeAttnBackend
+from sglang.srt.layers.radix_attention import AttentionType
+from sglang.srt.mem_cache.memory_pool import KVWriteLoc
+
+if TYPE_CHECKING:
+    from sglang.srt.layers.radix_attention import RadixAttention
+    from sglang.srt.model_executor.forward_batch_info import ForwardBatch
+    from sglang.srt.model_executor.model_runner import ModelRunner
+
+
+@dataclass
+class HPUBlockwiseDecodeMetadata:
+    batch_size: int
+    padded_batch_size: int
+    num_blocks: int
+    padded_num_blocks: int
+    token_indices: torch.Tensor
+    block_mapping: torch.Tensor
+    block_groups: torch.Tensor
+    block_bias: torch.Tensor
+
+
+def generate_exponential_buckets(max_value: int, limit: int) -> tuple[int, ...]:
+    if max_value <= 0:
+        raise ValueError("max_value must be positive")
+    if limit <= 0:
+        raise ValueError("limit must be positive")
+    if max_value == 1 or limit == 1:
+        return (max_value,)
+
+    log_max = math.log(max_value)
+    buckets = {
+        max(1, min(max_value, math.ceil(math.exp(log_max * index / (limit - 1)))))
+        for index in range(limit)
+    }
+    buckets.update((1, max_value))
+    return tuple(sorted(buckets))
+
+
+def strip_decode_batch_padding(
+    req_pool_indices: torch.Tensor,
+    seq_lens_cpu: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Remove trailing zero rows inserted by SGLang's static graph buffers."""
+    if seq_lens_cpu.ndim != 1 or req_pool_indices.ndim != 1:
+        raise ValueError("decode request indices and sequence lengths must be vectors")
+    if seq_lens_cpu.shape[0] != req_pool_indices.shape[0]:
+        raise ValueError("decode request indices and sequence lengths must match")
+
+    positive = seq_lens_cpu > 0
+    batch_size = int(positive.sum().item())
+    if batch_size == 0 or not bool(torch.all(positive[:batch_size])):
+        raise ValueError(
+            "decode sequence lengths must be positive before graph padding"
+        )
+    if bool(torch.any(seq_lens_cpu[batch_size:] != 0)):
+        raise ValueError("decode graph padding must contain only trailing zero lengths")
+    return req_pool_indices[:batch_size], seq_lens_cpu[:batch_size]
+
+
+def build_blockwise_decode_metadata(
+    *,
+    req_to_token: torch.Tensor,
+    req_pool_indices: torch.Tensor,
+    seq_lens_cpu: torch.Tensor,
+    block_size: int,
+    padded_batch_size: int,
+    padded_num_blocks: int,
+    dtype: torch.dtype,
+) -> HPUBlockwiseDecodeMetadata:
+    if block_size <= 0:
+        raise ValueError("block_size must be positive")
+    batch_size = req_pool_indices.shape[0]
+    if padded_batch_size < batch_size:
+        raise ValueError("padded_batch_size cannot be smaller than batch_size")
+
+    sequence_lengths = [int(length) for length in seq_lens_cpu.tolist()]
+    if len(sequence_lengths) != batch_size or any(
+        length <= 0 for length in sequence_lengths
+    ):
+        raise ValueError(
+            "decode sequence lengths must be positive and match batch_size"
+        )
+    if any(length > req_to_token.shape[1] for length in sequence_lengths):
+        raise ValueError("decode sequence length exceeds the request-token table")
+
+    blocks_per_request = [
+        (length + block_size - 1) // block_size for length in sequence_lengths
+    ]
+    num_blocks = sum(blocks_per_request)
+    if padded_num_blocks < num_blocks:
+        raise ValueError("padded_num_blocks cannot be smaller than num_blocks")
+
+    block_groups_cpu: list[int] = []
+    block_starts_cpu: list[int] = []
+    valid_counts_cpu: list[int] = []
+    for request_index, (length, request_blocks) in enumerate(
+        zip(sequence_lengths, blocks_per_request, strict=True)
+    ):
+        for request_block in range(request_blocks):
+            block_start = request_block * block_size
+            block_groups_cpu.append(request_index)
+            block_starts_cpu.append(block_start)
+            valid_counts_cpu.append(min(block_size, length - block_start))
+
+    device = req_to_token.device
+    if num_blocks:
+        block_groups_real = torch.tensor(
+            block_groups_cpu, dtype=torch.int64, device=device
+        )
+        block_starts = torch.tensor(
+            block_starts_cpu, dtype=torch.int64, device=device
+        ).view(-1, 1)
+        positions = block_starts + torch.arange(
+            block_size, dtype=torch.int64, device=device
+        ).view(1, -1)
+        safe_positions = positions.masked_fill(positions >= req_to_token.shape[1], 0)
+        request_rows = req_pool_indices[block_groups_real].view(-1, 1)
+        token_indices = req_to_token[request_rows, safe_positions]
+    else:
+        token_indices = torch.empty(
+            (0, block_size), dtype=req_to_token.dtype, device=device
+        )
+
+    padding_blocks = padded_num_blocks - num_blocks
+    if padding_blocks:
+        token_indices = F.pad(token_indices, (0, 0, 0, padding_blocks), value=0)
+
+    sentinel_group = padded_batch_size
+    all_groups_cpu = block_groups_cpu + [sentinel_group] * padding_blocks
+    block_groups = torch.tensor(all_groups_cpu, dtype=torch.int64, device=device)
+    block_mapping = F.one_hot(
+        torch.tensor(all_groups_cpu, dtype=torch.int64, device=device),
+        num_classes=padded_batch_size + 1,
+    )[:, :padded_batch_size].to(dtype=dtype)
+
+    # Dummy blocks contain one valid zero-cache token. Their mapping row is all
+    # zeros, so they cannot affect a real request while remaining numerically
+    # well-defined inside the block softmax kernel.
+    all_valid_counts = valid_counts_cpu + [1] * padding_blocks
+    valid_counts = torch.tensor(
+        all_valid_counts, dtype=torch.int32, device=device
+    ).view(-1, 1)
+    block_positions = torch.arange(block_size, dtype=torch.int32, device=device).view(
+        1, -1
+    )
+    valid_tokens = block_positions < valid_counts
+    block_bias = torch.zeros(
+        valid_tokens.shape, dtype=dtype, device=device
+    ).masked_fill(~valid_tokens, -math.inf)
+
+    return HPUBlockwiseDecodeMetadata(
+        batch_size=batch_size,
+        padded_batch_size=padded_batch_size,
+        num_blocks=num_blocks,
+        padded_num_blocks=padded_num_blocks,
+        token_indices=token_indices,
+        block_mapping=block_mapping,
+        block_groups=block_groups,
+        block_bias=block_bias,
+    )
+
+
+def _fallback_block_rescale(
+    block_max: torch.Tensor,
+    block_sums: torch.Tensor,
+    block_groups: torch.Tensor,
+    batch_size: int,
+) -> torch.Tensor:
+    rescale = torch.zeros_like(block_max)
+    groups = block_groups.to(torch.int64)
+    for group in range(batch_size):
+        selected = torch.nonzero(groups == group, as_tuple=False).flatten()
+        if selected.numel() == 0:
+            continue
+        selected_max = block_max.index_select(0, selected)
+        selected_sums = block_sums.index_select(0, selected)
+        group_max = selected_max.amax(dim=0, keepdim=True)
+        adjustment = (selected_max - group_max).exp()
+        denominator = (selected_sums * adjustment).sum(dim=0, keepdim=True)
+        rescale.index_copy_(0, selected, adjustment / denominator)
+    return rescale
+
+
+def blockwise_decode_attention(
+    query: torch.Tensor,
+    key_cache: torch.Tensor,
+    value_cache: torch.Tensor,
+    metadata: HPUBlockwiseDecodeMetadata,
+    scale: float,
+    *,
+    use_hpu_fused_ops: bool = True,
+) -> torch.Tensor:
+    batch_size, query_heads, head_size = query.shape
+    if batch_size != metadata.padded_batch_size:
+        raise ValueError("query batch must match padded blockwise metadata")
+
+    key = key_cache[metadata.token_indices].transpose(1, 2)
+    value = value_cache[metadata.token_indices].transpose(1, 2)
+    kv_heads = key.shape[1]
+    if query_heads % kv_heads:
+        raise ValueError("query heads must be divisible by KV heads")
+
+    query = torch.matmul(
+        metadata.block_mapping,
+        (query * scale).reshape(batch_size, -1),
+    ).view(metadata.padded_num_blocks, query_heads, 1, head_size)
+    block_bias = metadata.block_bias.view(metadata.padded_num_blocks, 1, 1, -1)
+
+    if query_heads != kv_heads:
+        query = query.unflatten(1, (kv_heads, query_heads // kv_heads))
+        key = key.unflatten(1, (kv_heads, 1))
+        value = value.unflatten(1, (kv_heads, 1))
+        block_bias = block_bias.unsqueeze(2)
+
+    scores = torch.matmul(query, key.transpose(-2, -1))
+    fused_ops_available = (
+        use_hpu_fused_ops
+        and query.device.type == "hpu"
+        and scores.dim() == 5
+        and hasattr(torch.ops.hpu, "block_softmax")
+        and hasattr(torch.ops.hpu, "block_softmax_adjustment")
+    )
+    if fused_ops_available:
+        probabilities, block_max, block_sums = torch.ops.hpu.block_softmax(
+            scores, block_bias, metadata.block_groups
+        )
+    else:
+        scores = scores + block_bias
+        block_max = scores.amax(dim=-1, keepdim=True)
+        probabilities = (scores - block_max).exp()
+        block_sums = probabilities.sum(dim=-1, keepdim=True)
+
+    block_output = torch.matmul(probabilities, value)
+    if fused_ops_available:
+        out_shape = list(block_output.shape[:3]) + [1] * (block_output.dim() - 3)
+        rescale = torch.ops.hpu.block_softmax_adjustment(
+            block_max,
+            block_sums.to(block_max.dtype),
+            metadata.block_groups,
+            batch_size,
+            out_shape,
+        ).to(block_output.dtype)
+    else:
+        rescale = _fallback_block_rescale(
+            block_max, block_sums, metadata.block_groups, batch_size
+        )
+    block_output = block_output * rescale
+
+    output = torch.matmul(
+        metadata.block_mapping.transpose(0, 1),
+        block_output.reshape(metadata.padded_num_blocks, -1),
+    ).view(batch_size, query_heads, head_size)
+    return output
+
+
+class HPUBlockwiseAttnBackend(TorchNativeAttnBackend):
+    """Gaudi blockwise decode attention over SGLang-owned KV slots."""
+
+    def __init__(self, model_runner: ModelRunner):
+        if model_runner.device != "hpu":
+            raise ValueError("hpu_blockwise attention requires an HPU device")
+        super().__init__(model_runner)
+        if model_runner.dtype != torch.bfloat16:
+            raise ValueError("hpu_blockwise attention currently requires BF16 weights")
+        if self.token_to_kv_pool.store_dtype != torch.bfloat16:
+            raise ValueError(
+                "hpu_blockwise attention currently requires a BF16 KV cache"
+            )
+
+        self.batch_bucket_step = int(
+            os.environ.get("SGLANG_HPU_DECODE_BATCH_BUCKET_STEP", "32")
+        )
+        self.block_size = int(os.environ.get("SGLANG_HPU_ATTENTION_BLOCK_SIZE", "128"))
+        self.block_bucket_limit = int(
+            os.environ.get("SGLANG_HPU_BLOCK_BUCKET_LIMIT", "16")
+        )
+        self.block_bucket_step = int(
+            os.environ.get("SGLANG_HPU_DECODE_BLOCK_BUCKET_STEP", "32")
+        )
+        self.bucket_padding_max = int(os.environ.get("SGLANG_HPU_BUCKET_PAD_MAX", "0"))
+        self.bucket_padding_percent = int(
+            os.environ.get("SGLANG_HPU_BUCKET_PAD_PERCENT", "25")
+        )
+        self.bucketing_strategy = os.environ.get(
+            "SGLANG_HPU_BUCKETING_STRATEGY", "exp"
+        ).lower()
+        if (
+            min(
+                self.batch_bucket_step,
+                self.block_size,
+                self.block_bucket_limit,
+                self.block_bucket_step,
+            )
+            <= 0
+        ):
+            raise ValueError("HPU blockwise bucket settings must be positive")
+
+        self.max_context_length = model_runner.model_config.context_len
+        self.max_bs = model_runner.server_args.cuda_graph_config.decode.max_bs
+        max_blocks = self.max_bs * (
+            (self.max_context_length + self.block_size - 1) // self.block_size
+        )
+        explicit_batch_buckets = os.environ.get("SGLANG_HPU_DECODE_BATCH_BUCKETS")
+        self.batch_buckets = (
+            parse_hpu_batch_buckets(explicit_batch_buckets, self.max_bs)
+            if explicit_batch_buckets
+            else generate_hpu_batch_buckets(
+                self.max_bs,
+                self.batch_bucket_step,
+                strategy=self.bucketing_strategy,
+                max_padding=self.bucket_padding_max,
+                max_padding_percent=self.bucket_padding_percent,
+            )
+        )
+        if self.bucketing_strategy == "pad":
+            self.block_buckets = generate_padding_aware_buckets(
+                1,
+                self.block_bucket_step,
+                max_blocks,
+                max_padding=self.bucket_padding_max or math.ceil(max_blocks / 4),
+                max_padding_percent=self.bucket_padding_percent,
+            )
+        else:
+            self.block_buckets = generate_exponential_buckets(
+                max_blocks, self.block_bucket_limit
+            )
+        self.forward_metadata: Optional[HPUBlockwiseDecodeMetadata] = None
+
+    def init_forward_metadata(self, forward_batch: ForwardBatch):
+        super().init_forward_metadata(forward_batch)
+        self.forward_metadata = None
+        if not forward_batch.forward_mode.is_decode():
+            return
+        if forward_batch.seq_lens_cpu is None:
+            raise ValueError("hpu_blockwise decode requires CPU sequence lengths")
+
+        req_pool_indices, seq_lens_cpu = strip_decode_batch_padding(
+            forward_batch.req_pool_indices,
+            forward_batch.seq_lens_cpu,
+        )
+        padded_batch_size = select_bucket(forward_batch.batch_size, self.batch_buckets)
+        num_blocks = sum(
+            (int(length) + self.block_size - 1) // self.block_size
+            for length in seq_lens_cpu.tolist()
+        )
+        padded_num_blocks = select_bucket(num_blocks, self.block_buckets)
+        self.forward_metadata = build_blockwise_decode_metadata(
+            req_to_token=self.req_to_token_pool.req_to_token,
+            req_pool_indices=req_pool_indices,
+            seq_lens_cpu=seq_lens_cpu,
+            block_size=self.block_size,
+            padded_batch_size=padded_batch_size,
+            padded_num_blocks=padded_num_blocks,
+            dtype=torch.bfloat16,
+        )
+
+    def forward_decode(
+        self,
+        q,
+        k,
+        v,
+        layer: RadixAttention,
+        forward_batch: ForwardBatch,
+        save_kv_cache=True,
+    ):
+        if (
+            layer.is_cross_attention
+            or layer.attn_type != AttentionType.DECODER
+            or layer.sliding_window_size > -1
+            or q.dtype != torch.bfloat16
+            or layer.qk_head_dim != layer.v_head_dim
+            or layer.tp_q_head_num == layer.tp_k_head_num
+        ):
+            return super().forward_decode(q, k, v, layer, forward_batch, save_kv_cache)
+
+        metadata = self.forward_metadata
+        if metadata is None:
+            raise RuntimeError("hpu_blockwise decode metadata was not initialized")
+
+        q = q.reshape(-1, layer.tp_q_head_num, layer.qk_head_dim)
+        if save_kv_cache and k is not None and v is not None:
+            self.token_to_kv_pool.set_kv_buffer(
+                layer,
+                KVWriteLoc(forward_batch.out_cache_loc, self.swa_out_cache_loc),
+                k,
+                v,
+            )
+
+        batch_padding = metadata.padded_batch_size - metadata.batch_size
+        if batch_padding:
+            q = F.pad(q, (0, 0, 0, 0, 0, batch_padding))
+
+        output = blockwise_decode_attention(
+            q,
+            self.token_to_kv_pool.get_key_buffer(layer.layer_id),
+            self.token_to_kv_pool.get_value_buffer(layer.layer_id),
+            metadata,
+            layer.scaling,
+        )
+        output = output[: metadata.batch_size]
+        return output.reshape(metadata.batch_size, -1)
