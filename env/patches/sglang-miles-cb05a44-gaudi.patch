+import math
+
+import pytest
+import torch
+import torch.nn.functional as F
+
+from sglang.srt.layers.attention.hpu_blockwise_backend import (
+    blockwise_decode_attention,
+    build_blockwise_decode_metadata,
+    generate_exponential_buckets,
+    select_bucket,
+    strip_decode_batch_padding,
+)
+from sglang.srt.utils.common import support_triton
+from sglang.test.ci.ci_register import register_cpu_ci
+
+register_cpu_ci(est_time=5, suite="base-a-test-cpu")
+
+
+def _reference_attention(query, key_cache, value_cache, token_rows, lengths, scale):
+    outputs = []
+    for request, length in enumerate(lengths):
+        indices = token_rows[request, :length]
+        key = key_cache[indices].transpose(0, 1).unsqueeze(0)
+        value = value_cache[indices].transpose(0, 1).unsqueeze(0)
+        output = F.scaled_dot_product_attention(
+            query[request].unsqueeze(0).unsqueeze(2),
+            key,
+            value,
+            dropout_p=0.0,
+            is_causal=False,
+            scale=scale,
+            enable_gqa=True,
+        )
+        outputs.append(output.squeeze(0).squeeze(1))
+    return torch.stack(outputs)
+
+
+@pytest.mark.parametrize("limit", [1, 4, 16])
+def test_exponential_buckets_include_bounds(limit):
+    buckets = generate_exponential_buckets(2048, limit)
+    assert buckets[0] >= 1
+    assert buckets[-1] == 2048
+    assert tuple(sorted(set(buckets))) == buckets
+
+
+def test_select_bucket_uses_first_fit_and_allows_overflow():
+    buckets = (1, 4, 16)
+    assert select_bucket(1, buckets) == 1
+    assert select_bucket(3, buckets) == 4
+    assert select_bucket(17, buckets) == 17
+
+
+def test_blockwise_backend_does_not_dispatch_triton():
+    assert not support_triton("hpu_blockwise")
+
+
+def test_strip_decode_batch_padding_keeps_real_request_prefix():
+    req_pool_indices = torch.tensor([7, 2, 11, 0, 0], dtype=torch.int64)
+    seq_lens_cpu = torch.tensor([129, 257, 511, 0, 0], dtype=torch.int32)
+
+    actual_indices, actual_lengths = strip_decode_batch_padding(
+        req_pool_indices, seq_lens_cpu
+    )
+
+    torch.testing.assert_close(actual_indices, req_pool_indices[:3])
+    torch.testing.assert_close(actual_lengths, seq_lens_cpu[:3])
+
+
+@pytest.mark.parametrize(
+    "lengths",
+    [
+        [0, 0],
+        [17, 0, 9],
+        [17, -1, 0],
+    ],
+)
+def test_strip_decode_batch_padding_rejects_invalid_rows(lengths):
+    with pytest.raises(ValueError):
+        strip_decode_batch_padding(
+            torch.arange(len(lengths), dtype=torch.int64),
+            torch.tensor(lengths, dtype=torch.int32),
+        )
+
+
+@pytest.mark.parametrize("query_heads,kv_heads", [(4, 4), (4, 2), (4, 1)])
+def test_blockwise_attention_matches_dense_for_fragmented_kv_slots(
+    query_heads, kv_heads
+):
+    torch.manual_seed(1234)
+    lengths = [1, 7, 8, 9, 21]
+    batch_size = len(lengths)
+    context_length = 24
+    block_size = 8
+    head_size = 8
+    total_cache_tokens = batch_size * context_length + 17
+
+    physical_slots = torch.randperm(total_cache_tokens)[: batch_size * context_length]
+    token_rows = physical_slots.view(batch_size, context_length)
+    req_to_token = torch.zeros(16, context_length, dtype=torch.int64)
+    req_pool_indices = torch.tensor([7, 2, 11, 4, 9], dtype=torch.int64)
+    req_to_token[req_pool_indices] = token_rows
+
+    key_cache = torch.randn(total_cache_tokens, kv_heads, head_size)
+    value_cache = torch.randn_like(key_cache)
+    query = torch.randn(batch_size, query_heads, head_size)
+    scale = 1.0 / math.sqrt(head_size)
+
+    num_blocks = sum((length + block_size - 1) // block_size for length in lengths)
+    metadata = build_blockwise_decode_metadata(
+        req_to_token=req_to_token,
+        req_pool_indices=req_pool_indices,
+        seq_lens_cpu=torch.tensor(lengths, dtype=torch.int32),
+        block_size=block_size,
+        padded_batch_size=8,
+        padded_num_blocks=num_blocks + 3,
+        dtype=query.dtype,
+    )
+    padded_query = F.pad(query, (0, 0, 0, 0, 0, 3))
+    actual = blockwise_decode_attention(
+        padded_query,
+        key_cache,
+        value_cache,
+        metadata,
+        scale,
+        use_hpu_fused_ops=False,
+    )[:batch_size]
+    expected = _reference_attention(
+        query, key_cache, value_cache, token_rows, lengths, scale
+    )
+
+    torch.testing.assert_close(actual, expected, rtol=1e-5, atol=1e-5)
+    assert metadata.token_indices.shape == (num_blocks + 3, block_size)
+    assert not metadata.block_mapping[num_blocks:].any()
+    assert metadata.block_groups[num_blocks:].eq(8).all()
