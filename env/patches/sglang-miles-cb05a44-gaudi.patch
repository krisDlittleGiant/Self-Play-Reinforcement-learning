+import unittest
+
+import torch
+
+from sglang.srt.layers.logprob_processor import OutputLogprobProcessor
+from sglang.test.ci.ci_register import register_cpu_ci
+
+register_cpu_ci(est_time=5, suite="base-a-test-cpu")
+
+
+class TestSampledTokenLogprobs(unittest.TestCase):
+    def test_matches_full_logprob_gather(self):
+        probabilities = torch.tensor(
+            [[0.1, 0.6, 0.3], [0.25, 0.25, 0.5]],
+            dtype=torch.float32,
+        )
+        token_ids = torch.tensor([1, 2], dtype=torch.int32)
+
+        actual = OutputLogprobProcessor.compute_sampled_token_logprobs(
+            probabilities,
+            token_ids,
+        )
+        expected = probabilities.log()[torch.arange(2), token_ids]
+
+        torch.testing.assert_close(actual, expected)
+
+    def test_clamps_zero_probability(self):
+        probabilities = torch.tensor([[0.0, 1.0]], dtype=torch.float32)
+
+        actual = OutputLogprobProcessor.compute_sampled_token_logprobs(
+            probabilities,
+            torch.tensor([0]),
+        )
+
+        self.assertEqual(actual.item(), torch.finfo(torch.float32).min)
+
+
+if __name__ == "__main__":
+    unittest.main()
