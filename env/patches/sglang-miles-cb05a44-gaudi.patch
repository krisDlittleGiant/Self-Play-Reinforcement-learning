+def test_page_start_free_path_avoids_token_deduplication():
+    page_size = 4
+    allocator = PagedTokenToKVPoolAllocator(
+        size=24,
+        page_size=page_size,
+        dtype=torch.bfloat16,
+        device="cpu",
+        kvcache=_FakeKVCache(num_slots=28),
+        need_sort=False,
+    )
+    allocated = allocator.alloc(4 * page_size)
+    torch.testing.assert_close(allocated, torch.arange(4, 20))
+
+    allocator.free_group_begin()
+    allocator.free_page_starts(torch.tensor([4, 8], dtype=torch.int64))
+    allocator.free_page_starts(torch.tensor([16], dtype=torch.int64))
+    allocator.free_group_end()
+
+    torch.testing.assert_close(
+        allocator.free_pages,
+        torch.tensor([1, 2, 4, 5, 6], dtype=torch.int64),
+    )
+
